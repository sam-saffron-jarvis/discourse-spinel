+/* A class object and its instances can use the same Ruby ivar spelling.
+   Their physical stores are distinct, but ClassInfo's representation slot is
+   shared. A container return pin must not pin the other home's scalar store. */
+static int seed_ivar_home(Compiler *c, int id, int cid) {
+  Scope *s = comp_scope_of(c, id);
+  if (s && s->class_id == cid) {
+    if (s->is_cmethod) return 2;
+    if (!s->is_proc_form && s->def_node >= 0) return 1;
+  }
+  if ((!s || s->class_id < 0) && c->node_cbody && id < c->node_cap && c->node_cbody[id] == cid) return 2;
+  return 0;
+}
+static int seed_ivar_mixed_homes(Compiler *c, Scope *s, const char *name) {
+  const NodeTable *nt = c->nt;
+  int other = s->is_cmethod ? 1 : 2;
+  for (int id = 0; id < nt->count; id++) {
+    NodeKind k = nt_kind(nt, id);
+    if (k != NK_InstanceVariableReadNode && k != NK_InstanceVariableWriteNode &&
+        k != NK_InstanceVariableOrWriteNode && k != NK_InstanceVariableAndWriteNode &&
+        k != NK_InstanceVariableOperatorWriteNode) continue;
+    const char *nm = nt_str(nt, id, "name");
+    if (nm && sp_streq(nm, name) && seed_ivar_home(c, id, s->class_id) == other) return 1;
+  }
+  return 0;
+}
