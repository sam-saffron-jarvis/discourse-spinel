+    NodeKind k = nt_kind(nt, id);
+    if (k != NK_InstanceVariableWriteNode && k != NK_InstanceVariableOrWriteNode) continue;
+    const char *nm = nt_str(nt, id, "name");
+    if (!nm || !sp_streq(nm, name) || seed_ivar_home(c, id, s->class_id) != home) continue;
