+                key: std::sync::Arc::new(crate::analyze::union_of((**key).clone(), Ty::Sym)),
+                value: std::sync::Arc::new(widen(value)),
+            },
+            Ty::Array { elem } => Ty::Array { elem: std::sync::Arc::new(widen(elem)) },
+            Ty::Union { variants } => Ty::Union { variants: variants.iter().map(widen).collect() },
+            other => other.clone(),
+        }
+    }
+    fn widen_containers(e: &mut Expr) {
+        if let Some(ty) = &e.ty { e.ty = Some(widen(ty)); }
+        e.node.for_each_child_mut(&mut widen_containers);
+    }
+    if calls_key_mutator(expr, mutators) { widen_containers(expr); }
