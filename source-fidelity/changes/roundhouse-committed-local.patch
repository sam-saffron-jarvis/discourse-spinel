+const SEEDFU_VERSION: &str = "module SeedFu\n  # The current version of Seed Fu\n  VERSION = '2.3.12'\nend\n";
+const CONSTANT_ENTRY: &str = r#"module SeedFu
+  autoload :VERSION, 'finitekit/version'
