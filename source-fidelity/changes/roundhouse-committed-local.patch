+rows = Article.with_selected_profile.order(:id).to_a
+repeated = Db.capture_sql do
+  raise 'scope erased' unless rows[0].selected_profile.id == p.id
+  raise 'missing scope result' unless rows[1].selected_profile.nil?
+  raise 'missing memoization' unless rows.all?(&:selected_profile_loaded?)
+  rows.each { |row| row.selected_profile }
+end
+raise 'repeat queried' unless repeated.empty?
+puts 'scoped has_one read preloading passed'
+"#).assert_passes();
+}
+
+/// A collection through a belongs_to is keyed from the real intermediate
+/// record, not the owner's id. Preloaded readers remain Relations (including
+/// a missing parent), with constraints intact when forked with where.
+#[test]
+fn belongs_to_through_collection_preserves_parent_key_and_relation_cache() {
+    let (path, from, to) = profile_schema_edit();
+    emit_and_run::real_blog()
+        .edit(path, from, to)
+        .edit("db/schema.rb", "  create_table \"articles\", force: :cascade do |t|",
+              "  create_table \"articles\", force: :cascade do |t|\n    t.integer \"profile_id\"")
+        .write("app/models/profile.rb", "class Profile < ApplicationRecord\n  belongs_to :article\n  has_many :notes, class_name: 'Comment', foreign_key: :article_id, primary_key: :article_id\nend\n")
+        .edit("app/models/article.rb", "  has_many :comments, dependent: :destroy",
+              "  has_many :comments, dependent: :destroy\n  belongs_to :profile, optional: true\n  has_many :related_comments, through: :profile, source: :notes\n  scope :with_related_comments, -> { includes(:related_comments) }")
+        .run_ruby(r#"
+a = Article.create!(title: 'Alpha', body: 'abcdefghij')
+b = Article.create!(title: 'Beta', body: 'abcdefghij')
+c = Article.create!(title: 'Gamma', body: 'abcdefghij')
+p = Profile.create!(article_id: b.id, bio: 'parent')
+a.profile_id = p.id
+a.save!
+x = Comment.create!(article_id: a.id, commenter: 'wrong', body: 'wrong owner')
+y = Comment.create!(article_id: b.id, commenter: 'right', body: 'actual parent')
+raise 'lazy parent FK' unless a.related_comments.to_a.map(&:id) == [y.id]
+rows = Article.with_related_comments.order(:id).to_a
+repeated = Db.capture_sql do
+  raise 'cached relation' unless rows[0].related_comments.is_a?(ActiveRecord::Relation)
+  raise 'parent key' unless rows[0].related_comments.to_a.map(&:id) == [y.id]
+  raise 'nil parent' unless rows[1].related_comments.to_a.empty?
+  raise 'missing memoization' unless rows.all?(&:related_comments_loaded?)
+end
+raise 'repeat queried' unless repeated.empty?
+raise 'fork dropped parent constraint' unless rows[0].related_comments.where(id: x.id).to_a.empty?
+raise 'fork lost actual row' unless rows[0].related_comments.where(id: y.id).to_a.map(&:id) == [y.id]
+raise 'nil parent fork' unless rows[2].related_comments.where(id: y.id).to_a.empty?
+puts 'belongs_to through read preloading passed'
+"#).assert_passes();
+}
diff --git a/tests/hash_deep_symbolize_keys.rs b/tests/hash_deep_symbolize_keys.rs
new file mode 100644
index 000000000..c7c94e6e7
--- /dev/null
+++ b/tests/hash_deep_symbolize_keys.rs
@@ -0,0 +1,93 @@
+//! Destructive recursive Hash key conversion, as used by YAML declaration
+//! loaders. Container identity and collision order are part of the contract.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const SOURCE: &str = r#"class DeepKeysProbe
+  def self.run
+    child = { "flag" => false, "zero" => 0, "empty" => "", "nil" => nil }
+    array = [child, { "more" => [ { "name" => "value" } ] }]
+    hash = { "nested" => child, "array" => array, "collision" => 1, collision: 2, 7 => "integer" }
+    result = hash.deep_symbolize_keys!
+    raise "receiver identity" unless result.equal?(hash)
+    raise "nested hash identity" unless hash[:nested].equal?(child)
+    raise "nested array identity" unless hash[:array].equal?(array)
+    raise "aliased child identity" unless array[0].equal?(child)
+    raise "false" unless child[:flag] == false
+    raise "zero" unless child[:zero] == 0
+    raise "empty" unless child[:empty] == ""
+    raise "nil" unless child[:nil].nil?
+    raise "recursive array" unless array[1][:more][0][:name] == "value"
+    raise "collision snapshot order" unless hash[:collision] == 1
+    raise "integer key" unless hash[7] == "integer"
+    raise "old key retained" if child.key?("flag")
+    raise "empty" unless ({}).deep_symbolize_keys! == {}
+    hash.deep_symbolize_keys!
+    raise "idempotent content" unless child[:flag] == false
+    puts "deep key mutation PASS"
+  end
+end
+"#;
+
+fn app(source: &str) -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("app/models/deep_keys_probe.rb", source)
+}
+
+fn yaml_source() -> String {
+    // YAML's open containers are the original loader's runtime shape. A
+    // statically String-keyed nested literal has a separate compiler limit.
+    SOURCE.replace("class DeepKeysProbe", "require \"yaml\"\nclass DeepKeysProbe")
+        .replace(
+            "    child = { \"flag\" => false, \"zero\" => 0, \"empty\" => \"\", \"nil\" => nil }\n    array = [child, { \"more\" => [ { \"name\" => \"value\" } ] }]\n    hash = { \"nested\" => child, \"array\" => array, \"collision\" => 1, collision: 2, 7 => \"integer\" }",
+            "    hash = YAML.load(\"nested: &child\\n  flag: false\\n  zero: 0\\n  empty: ''\\n  nil: null\\narray:\\n  - *child\\n  - more:\\n      - name: value\\ncollision: 1\\n7: integer\\n\", aliases: true)\n    if hash.is_a?(Hash)\n    child = hash[\"nested\"]\n    array = hash[\"array\"]\n    hash[:collision] = 2"
+        )
+        .replace("    puts \"deep key mutation PASS\"", "    puts \"deep key mutation PASS\"\n    else\n      raise \"wrong YAML fixture type\"\n    end")
+}
+
+#[test]
+fn destructive_deep_keys_run_on_emitted_ruby() {
+    assert!(roundhouse::runtime_files::exists("runtime/ruby/hash_transform_keys.rb"), "shared runtime embedded");
+    let run = app(SOURCE).run_ruby("DeepKeysProbe.run\n");
+    run.assert_passes();
+    assert_eq!(run.stdout, "deep key mutation PASS\n");
+    let emitted = std::fs::read_to_string(run.emitted.join("app/models/deep_keys_probe.rb"))
+        .expect("emitted probe");
+    assert!(emitted.contains("ActiveSupport.deep_symbolize_keys!(hash)"), "{emitted}");
+}
+
+#[test]
+fn wrapper_calls_invalidate_alias_key_evidence_too() {
+    let source = SOURCE
+        .replace("  def self.run", "  def self.convert(hash)\n    convert_inner(hash)\n  end\n  def self.convert_inner(hash)\n    hash.deep_symbolize_keys!\n  end\n  def self.run")
+        .replace("result = hash.deep_symbolize_keys!", "result = convert(hash)")
+        .replace("    hash.deep_symbolize_keys!\n    raise \"idempotent", "    convert(hash)\n    raise \"idempotent");
+    let run = app(&source).run_ruby("DeepKeysProbe.run\n");
+    run.assert_passes();
+    assert_eq!(run.stdout, "deep key mutation PASS\n");
+}
+
+#[test]
+fn yaml_deep_keys_run_on_emitted_ruby() {
+    let run = app(&yaml_source()).run_ruby("DeepKeysProbe.run\n");
+    run.assert_passes();
+    assert_eq!(run.stdout, "deep key mutation PASS\n");
+}
+
+#[test]
+#[ignore = "requires Spinel; no external services"]
+fn yaml_deep_keys_run_natively() {
+    let run = app(&yaml_source()).run_spinel_with_rbs("DeepKeysProbe.run\n");
+    run.assert_passes();
+    assert_eq!(run.stdout, "deep key mutation PASS\n");
+}
+
+#[test]
+#[ignore = "requires Spinel; pins the explicit unsupported nested literal layout"]
+fn nested_string_keyed_literal_refuses_instead_of_losing_entries() {
+    let run = app(SOURCE).run_spinel_with_rbs("DeepKeysProbe.run\n");
+    assert!(run.errors.is_empty(), "{:?}", run.errors);
+    assert!(!run.success);
+    assert!(run.stderr.contains("hash was not widened for this store"), "{}", run.stderr);
+}
diff --git a/tests/hash_replace_shape.rs b/tests/hash_replace_shape.rs
new file mode 100644
index 000000000..d35f9836b
--- /dev/null
+++ b/tests/hash_replace_shape.rs
@@ -0,0 +1,64 @@
+use roundhouse::{ingest::ingest_app_from_tree, ty::Ty};
+use std::{collections::HashMap, path::PathBuf};
+#[test]
+fn replace_never_invents_a_receiver_contract_after_mixed_or_unknown_mutation() {
+    let source = r#"class HashReplaceTypes
+  #: (Hash[Symbol, Integer] left, Hash[Symbol, Integer] right) -> untyped
+  def self.same(left, right)
+    left.replace(right)
+  end
+  #: (Hash[Symbol, Integer] left, Hash[String, String] right) -> untyped
+  def self.mixed(left, right)
+    left.replace(right)
+  end
+  #: (Hash[Symbol, Integer] left, untyped right) -> untyped
+  def self.unknown(left, right)
+    left.replace(right)
+  end
+  #: (Hash[Symbol, Integer] left) -> untyped
+  def self.arity(left)
+    left.replace
+  end
+end
+"#;
+    let tree = HashMap::from([
+        (
+            PathBuf::from("db/schema.rb"),
+            b"ActiveRecord::Schema.define do\nend\n".to_vec(),
+        ),
+        (
+            PathBuf::from("config/routes.rb"),
+            b"Rails.application.routes.draw do\nend\n".to_vec(),
+        ),
+        (
+            PathBuf::from("lib/hash_replace_types.rb"),
+            source.as_bytes().to_vec(),
+        ),
+    ]);
+    let mut app = ingest_app_from_tree(tree).unwrap();
+    roundhouse::analyze::Analyzer::new(&app).analyze(&mut app);
+    let class = app
+        .library_classes
+        .iter()
+        .find(|c| c.name.0.as_str() == "HashReplaceTypes")
+        .unwrap();
+    for method in &class.methods {
+        if method.name.as_str() == "same" {
+            assert!(
+                matches!(method.body.ty.as_ref(),Some(Ty::Hash{key,value}) if **key==Ty::Sym && **value==Ty::Int),
+                "{method:#?}"
+            );
+        } else {
+            assert!(
+                method
+                    .body
+                    .ty
+                    .as_ref()
+                    .is_none_or(|ty| ty.mentions_unknown()),
+                "{} falsely closed: {:?}",
+                method.name.as_str(),
+                method.body.ty
+            );
+        }
+    }
+}
diff --git a/tests/hash_reverse_merge_bang.rs b/tests/hash_reverse_merge_bang.rs
