+            }
+        }
+        for model in app.models.iter().filter(|model| model.name == event.owner) {
+            for method in model
+                .methods()
+                .filter(|method| method.receiver == MethodReceiver::Class)
+            {
+                collect(&method.body, true, owner_fields);
+            }
+        }
+    }
+}
