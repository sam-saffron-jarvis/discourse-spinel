+/// Data-only bootstrap expressions for the narrowly staged root declaration
+/// route. A runtime helper/callback must not observe the native future table.
+fn declaration_data_value(value: &Expr, constants: bool) -> bool {
+    match &*value.node {
+        ExprNode::Lit { .. } | ExprNode::SelfRef => true,
+        ExprNode::Const { .. } => constants,
+        ExprNode::Array { elements, .. } => elements.iter().all(|value| declaration_data_value(value, constants)),
+        ExprNode::Hash { entries, .. } => entries.iter().all(|(key, value)| declaration_data_value(key, constants) && declaration_data_value(value, constants)),
+        ExprNode::Send { recv: Some(recv), method, args, block: None, .. } if method.as_str() == "new" => {
+            matches!(&*recv.node, ExprNode::Const { path } if matches!(path.as_slice(),
+                [name] | [_, name] if (path.len() == 1 || path[0].as_str().is_empty())
+                    && matches!(name.as_str(), "Set" | "Array" | "Hash" | "String")))
+                && args.iter().all(|arg| declaration_data_value(arg, false))
+        }
+        _ => false,
+    }
+}
+
+fn declaration_state_event(statement: &Expr) -> bool {
+    match &*statement.node {
+        ExprNode::Assign { target: LValue::Ivar { .. }, value }
+            | ExprNode::Assign { target: LValue::Var { .. }, value } => touches_class_state(statement) && declaration_data_value(value, false),
+        ExprNode::Send { method, args, block: None, .. } => touches_class_state(statement)
+            && matches!(method.as_str(), "<<" | "push" | "add")
+            && args.iter().all(|value| declaration_data_value(value, false)),
+        _ => false,
+    }
+}
