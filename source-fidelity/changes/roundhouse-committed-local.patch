--- /dev/null
+++ b/tests/implicit_factory_constructor_args.rs
@@ -0,0 +1,293 @@
+//! Plugin::Instance.parse_from_source builds via implicit Class#new.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const SOURCE: &str = r#"class SourcePluginFactory
+  attr_reader :path
+  def self.parse(path)
+    new(path)
+  end
+  def initialize(path = nil)
+    @path = path
+  end
+  def self.exercise
+    instance = parse("source path")
+    raise "factory argument lost" unless instance.path == "source path"
+    raise "optional nil erased" unless new.path.nil?
+    puts "source implicit constructor PASS"
+  end
+end
+"#;
+fn app(source: &str) -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write(
+            "config/routes.rb",
+            "Rails.application.routes.draw do\nend\n",
+        )
+        .write("lib/source_plugin_factory.rb", source)
+}
+#[test]
+fn actual_factory_arguments_reach_the_real_initializer_without_annotations() {
+    use roundhouse::ty::Ty;
+    for source in [
+        SOURCE.to_string(),
+        SOURCE.replace("    new(path)", "    self.new(path)"),
+    ] {
+        let (emitted, typed, errors) =
+            app(&source).emit_with_app(roundhouse::project::BuildTarget::Spinel);
+        assert!(errors.is_empty(), "{errors:#?}");
+        let class = typed
+            .library_classes
+            .iter()
+            .find(|c| c.name.0.as_str() == "SourcePluginFactory")
+            .unwrap();
+        let initializer = class
+            .methods
+            .iter()
+            .find(|m| m.name.as_str() == "initialize")
+            .unwrap();
+        assert!(
+            matches!(&initializer.body.ty, Some(Ty::Union { variants }) if variants.contains(&Ty::Str) && variants.contains(&Ty::Nil)),
+            "{initializer:#?}"
+        );
+        let factory = class
+            .methods
+            .iter()
+            .find(|m| m.name.as_str() == "parse")
+            .unwrap();
+        assert!(
+            matches!(&factory.signature, Some(Ty::Fn { ret, .. }) if **ret == Ty::SelfInstance),
+            "{factory:#?}"
+        );
+        fn closed(expr: &roundhouse::expr::Expr) {
+            assert!(
+                expr.ty.as_ref().is_some_and(|ty| !ty.mentions_unknown()),
+                "{expr:#?}"
+            );
+            expr.node.for_each_child(&mut closed);
+        }
+        for method in &class.methods {
+            closed(&method.body);
+        }
+        let original = emit_and_run::ruby()
+            .args(["-e", &format!("{source}\nSourcePluginFactory.exercise")])
+            .output()
+            .unwrap();
+        let lowered = emit_and_run::ruby()
+            .args([
+                "-e",
+                "require_relative 'app/models'; SourcePluginFactory.exercise",
+            ])
+            .current_dir(&*emitted)
+            .output()
+            .unwrap();
+        assert!(
+            original.status.success(),
+            "{}",
+            String::from_utf8_lossy(&original.stderr)
+        );
+        assert!(
+            lowered.status.success(),
+            "{}",
+            String::from_utf8_lossy(&lowered.stderr)
+        );
+        assert_eq!(lowered.stdout, original.stdout);
+    }
+}
+#[test]
+fn custom_constructors_and_unproved_descendant_initializers_supply_no_builtin_site() {
+    use roundhouse::ty::Ty;
+    for (label, extra, parent, header, call) in [
+        (
+            "own new",
+            "def self.new(value = nil); :other_result; end",
+            "",
+            "",
+            "",
+        ),
+        (
+            "global Class new override",
+            "",
+            "",
+            "class Class\n def new(value = nil); :other_result; end\nend\n",
+            "",
+        ),
+        (
+            "inherited new",
+            "",
+            " < ConstructorParent",
+            "class ConstructorParent\n def self.new(value = nil); :other_result; end\nend\n",
+            "",
+        ),
+        (
+            "unknown descendant initialization",
+            "",
+            "",
+            "",
+            "class ConstructorChild < SourcePluginFactory\n def initialize(path); @path = 71; end\nend\n",
+        ),
+    ] {
+        let source = format!(
+            "{header}class SourcePluginFactory{parent}\n {extra}\n def self.parse(path)\n new(path)\n end\n def initialize(path = nil)\n @path = path\n end\n def self.exercise\n parse(\"observed source\")\n end\nend\n{call}"
+        );
+        let (_, typed, _) = app(&source).emit_with_app(roundhouse::project::BuildTarget::Spinel);
+        let method = typed
+            .library_classes
+            .iter()
+            .find(|c| c.name.0.as_str() == "SourcePluginFactory")
+            .unwrap()
+            .methods
+            .iter()
+            .find(|m| m.name.as_str() == "initialize")
+            .unwrap();
+        assert!(
+            !matches!(&method.body.ty, Some(Ty::Str))
+                && !matches!(&method.body.ty, Some(Ty::Union { variants }) if variants.contains(&Ty::Str)),
+            "{label}: {method:#?}"
+        );
+    }
+}
+#[test]
+#[ignore = "requires Spinel; no external services"]
+fn original_implicit_factory_argument_and_nil_semantics_run_natively() {
+    let (emitted, errors) = app(SOURCE).emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:#?}");
+    std::fs::write(
+        emitted.join("probe.rb"),
+        "require_relative 'app/models'; SourcePluginFactory.exercise\n",
+    )
+    .unwrap();
+    let compiled =
+        std::process::Command::new(std::env::var("SPINEL").unwrap_or_else(|_| "spinel".into()))
+            .args(["--jobs=4", "--rbs", ".", "probe.rb", "-o", "probe"])
+            .current_dir(&*emitted)
+            .output()
+            .unwrap();
+    assert!(
+        compiled.status.success(),
+        "{}",
+        String::from_utf8_lossy(&compiled.stderr)
+    );
+    let native = std::process::Command::new(emitted.join("probe"))
+        .current_dir(&*emitted)
+        .output()
+        .unwrap();
+    assert!(
+        native.status.success(),
+        "{}",
+        String::from_utf8_lossy(&native.stderr)
+    );
+    assert_eq!(native.stdout, b"source implicit constructor PASS\n");
+}
+
+#[test]
+#[ignore = "requires audited original settings input; diagnostic output never executed"]
+fn actual_plugin_factory_closes_path_and_metadata_but_not_enabled_setting_configuration() {
+    use roundhouse::ty::Ty;
+    let input =
+        std::env::var("ROUNDHOUSE_ORIGINAL_SETTINGS_APP").expect("audited original input required");
+    let mut app = roundhouse::ingest::ingest_app(std::path::Path::new(&input)).unwrap();
+    let _diagnostics = roundhouse::session::analyze_and_lower_for(
+        &mut app,
+        roundhouse::project::BuildTarget::Spinel,
+    );
+    let class = app
+        .library_classes
+        .iter()
+        .find(|c| c.name.0.as_str() == "Plugin::Instance")
+        .unwrap();
+    let path = class
+        .methods
+        .iter()
+        .find(|m| m.name.as_str() == "path")
+        .unwrap();
+    assert!(
+        matches!(&path.signature, Some(Ty::Fn { ret, .. }) if !ret.mentions_unknown() && matches!(&**ret, Ty::Union { variants } if variants.contains(&Ty::Str) && variants.contains(&Ty::Nil))),
+        "{path:#?}"
+    );
+    let metadata = class
+        .methods
+        .iter()
+        .find(|m| m.name.as_str() == "metadata")
+        .unwrap();
+    assert!(
+        matches!(&metadata.signature, Some(Ty::Fn { ret, .. }) if !ret.mentions_unknown() && matches!(&**ret, Ty::Union { variants } if variants.contains(&Ty::Nil) && variants.iter().any(|ty| matches!(ty, Ty::Class { id, .. } if id.0.as_str() == "Plugin::Metadata")))),
+        "{metadata:#?}"
+    );
+    let enabled = class
+        .methods
+        .iter()
+        .find(|m| m.name.as_str() == "enabled_site_setting")
+        .unwrap();
+    assert!(
+        matches!(&enabled.signature, Some(Ty::Fn { ret, .. }) if ret.mentions_unknown()),
+        "missing external configuration producer must stay open: {enabled:#?}"
+    );
+    assert!(
+        !app.runtime_definition_families
+            .iter()
+            .any(|family| family.owner.0.as_str() == "SiteSetting")
+    );
+    if let Ok(output) = std::env::var("ROUNDHOUSE_ORIGINAL_PLUGIN_IR") {
+        std::fs::write(output, serde_json::to_string_pretty(class).unwrap()).unwrap();
+    }
+}
+
+#[test]
+fn an_explicit_gradual_initializer_parameter_is_not_replaced_by_factory_evidence() {
+    let source = SOURCE.replace(
+        "  def initialize(path = nil)",
+        "  #: (?untyped path) -> void\n  def initialize(path = nil)",
+    );
+    let (_, typed, _) = app(&source).emit_with_app(roundhouse::project::BuildTarget::Spinel);
+    assert!(
+        typed
+            .rbs_signatures
+            .get(&roundhouse::ClassId(roundhouse::Symbol::from(
+                "SourcePluginFactory"
+            )))
+            .is_some_and(|methods| methods.contains_key(&roundhouse::Symbol::from("initialize"))),
+        "the optional source declaration must actually be parsed"
+    );
+    let method = typed
+        .library_classes
+        .iter()
+        .find(|c| c.name.0.as_str() == "SourcePluginFactory")
+        .unwrap()
+        .methods
+        .iter()
+        .find(|m| m.name.as_str() == "initialize")
+        .unwrap();
+    assert!(
+        method
+            .body
+            .ty
+            .as_ref()
+            .is_none_or(roundhouse::ty::Ty::mentions_unknown),
+        "{method:#?} declarations={:#?}",
+        typed.rbs_signatures
+    );
+}
+
+#[test]
+fn an_unknown_passed_factory_argument_does_not_become_the_nil_default() {
+    let source = SOURCE.replace("parse(\"source path\")", "parse(unknown_source_path)");
+    let (_, typed, _) = app(&source).emit_with_app(roundhouse::project::BuildTarget::Spinel);
+    let method = typed
+        .library_classes
+        .iter()
+        .find(|c| c.name.0.as_str() == "SourcePluginFactory")
+        .unwrap()
+        .methods
+        .iter()
+        .find(|m| m.name.as_str() == "initialize")
+        .unwrap();
+    assert!(
+        method
+            .body
+            .ty
+            .as_ref()
+            .is_none_or(roundhouse::ty::Ty::mentions_unknown),
+        "{method:#?}"
+    );
+}
diff --git a/tests/interned_macro_names.rs b/tests/interned_macro_names.rs
new file mode 100644
index 000000000..3f4097be0
--- /dev/null
+++ b/tests/interned_macro_names.rs
@@ -0,0 +1,75 @@
+//! The original settings declaration shape computes an interned name with
+//! name.to_s.sub("?", "").to_sym and captures a scalar into optional-arg readers.
+//! This is pure declaration execution: no PG, Redis, settings snapshots or boot.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const BASE: &str = r##"class DeclarationBase
+  def self.declare(name, value)
+    clean_name = name.to_s.sub("?", "").to_sym
+    define_singleton_method clean_name do |scoped_to = nil|
+      value
+    end
+  end
+  def self.capture(name)
+    value = name.to_s.sub("?", "")
+    clean_name = name.to_s.sub("?", "").to_sym
+    define_singleton_method clean_name do
+      value
+    end
+  end
+end
+class DeclarationValues < DeclarationBase
+  declare :disabled?, false
+  declare "enabled?", true
+  declare "first??", 7
+  declare "plain", nil
+  capture :mutable?
+end
+"##;
+
+fn app(source: &str) -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("lib/declaration_values.rb", source)
+}
+
+const PROBE: &str = r#"
+raise "false capture" unless DeclarationValues.disabled == false
+raise "optional reader" unless DeclarationValues.disabled(:scope) == false
+raise "true capture" unless DeclarationValues.enabled == true
+raise "only first occurrence" unless DeclarationValues.first? == 7
+raise "nil capture" unless DeclarationValues.plain.nil?
+DeclarationValues.mutable << "!"
+raise "mutable captured allocation" unless DeclarationValues.mutable == "mutable!"
+puts "interned declaration captures preserved"
+"#;
+
+#[test]
+fn interned_sub_names_and_scalar_captures_run_on_emitted_ruby() {
+    let run = app(BASE).run_ruby(PROBE);
+    run.assert_passes();
+    assert_eq!(run.stdout, "interned declaration captures preserved\n");
+}
+
+#[test]
+#[ignore = "requires Spinel; SQLite-memory scaffold only"]
+fn interned_sub_names_and_scalar_captures_run_natively() {
+    let run = app(BASE).run_spinel_with_rbs(PROBE);
+    run.assert_passes();
+    assert_eq!(run.stdout, "interned declaration captures preserved\n");
+}
+
+#[test]
+fn substitution_on_non_strings_is_not_invented() {
+    let source = BASE.replace("name.to_s.sub", "name.sub");
+    let (_tree, errors) = app(&source).emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.iter().any(|e| e.contains("does not expand") || e.contains("not supported")), "{errors:#?}");
+}
+
+#[test]
+fn substitution_replacement_backreferences_are_not_guessed() {
+    let source = BASE.replace("sub(\"?\", \"\")", "sub(\"?\", \"\\\\&\")");
+    let (_tree, errors) = app(&source).emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.iter().any(|e| e.contains("does not expand") || e.contains("not supported")), "{errors:#?}");
+}
diff --git a/tests/library_accessor_splat.rs b/tests/library_accessor_splat.rs
new file mode 100644
index 000000000..616e97777
--- /dev/null
+++ b/tests/library_accessor_splat.rs
@@ -0,0 +1,204 @@
+use roundhouse::expr::{ExprNode, LValue};
+use roundhouse::ingest::ingest_app_from_tree;
+
+fn class(source: &str) -> roundhouse::dialect::LibraryClass {
+    let app = ingest_app_from_tree(
+        vec![(
+            std::path::PathBuf::from("lib/plugin/metadata.rb"),
+            source.as_bytes().to_vec(),
+        )]
+        .into_iter()
+        .collect(),
+    )
+    .expect("ingest app");
+    app.library_classes
+        .into_iter()
+        .find(|class| class.name.0.as_str() == "Plugin::Metadata")
+        .expect("Plugin::Metadata ingested")
+}
+
+fn reduced_metadata(body: &str) -> String {
+    format!("module Plugin\n  class Metadata\n{body}  end\nend\n")
+}
+
+#[test]
+fn constant_splat_accessor_matches_direct_symbol_and_string_accessors() {
+    let expanded = class(&reduced_metadata(
+        "    FIELDS = %i[name status]\n    attr_accessor(*FIELDS)\n",
+    ));
+    let direct = class(&reduced_metadata("    attr_accessor :name, \"status\"\n"));
+
+    let projection = |class: &roundhouse::dialect::LibraryClass| {
+        class
+            .methods
+            .iter()
+            .map(|method| {
+                (
+                    method.name.clone(),
+                    method.receiver,
+                    method.params.clone(),
+                    method.body.clone(),
+                )
+            })
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(projection(&expanded), projection(&direct));
+
+    for setter in ["name=", "status="] {
+        let method = expanded
+            .methods
+            .iter()
+            .find(|method| method.name.as_str() == setter)
+            .unwrap();
+        let ExprNode::Assign {
+            target: LValue::Ivar { name },
+            value,
+        } = &*method.body.node
+        else {
+            panic!(
+                "{setter} must assign its actual argument directly: {:?}",
+                method.body.node
+            );
+        };
+        assert_eq!(name.as_str(), setter.trim_end_matches('='));
+        assert!(matches!(&*value.node, ExprNode::Var { name, .. } if name.as_str() == "value"));
+    }
+}
+
+#[test]
+fn unsupported_or_ambiguous_splats_remain_as_original_unknown_calls() {
+    let cases = [
+        // Forward constant references are not visible at this call site.
+        "    attr_accessor(*FIELDS)\n    FIELDS = %i[name status]\n",
+        // A later mutation taints the whole-body constant fact.
+        "    FIELDS = %i[name status]\n    attr_accessor(*FIELDS)\n    FIELDS << :extra\n",
+        // Aliases and subsequent writes are conservatively tainted.
+        "    FIELDS = %i[name status]\n    ALIAS = FIELDS\n    ALIAS << :extra\n    attr_accessor(*FIELDS)\n",
+        // The entire call declines rather than keeping the known prefix.
+        "    FIELDS = %i[name status]\n    attr_accessor(:safe, *FIELDS, Object.new)\n",
+        // Names that cannot safely map to ordinary instance variables decline.
+        "    FIELDS = [:name, :\"not-safe?\"]\n    attr_accessor(*FIELDS)\n",
+    ];
+
+    for body in cases {
+        let ingested = class(&reduced_metadata(body));
+        assert!(
+            ingested.methods.is_empty(),
+            "must not synthesize a partial accessor set: {body}"
+        );
+        assert!(
+            ingested.unknown_calls.iter().any(|expr| {
+                matches!(&*expr.node, ExprNode::Send { method, .. } if method.as_str() == "attr_accessor")
+            }),
+            "original accessor call must remain represented: {body}"
+        );
+    }
+}
+
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const EXECUTABLE: &str = r#"class AccessorMetadata
+  FIELDS = %i[name version].freeze
+  attr_accessor(*FIELDS)
+  def initialize
+    @name = "initial"
+    @version = "1"
+  end
+  def self.exercise
+    metadata = new
+    metadata.public_send(:name=, "source value")
+    metadata.public_send(:version=, "2")
+    raise "source accessor name" unless metadata.name == "source value"
+    raise "source accessor version" unless metadata.version == "2"
+    puts "source finite accessor PASS"
+  end
+end
+"#;
+
+fn app() -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write(
+            "config/routes.rb",
+            "Rails.application.routes.draw do\nend\n",
+        )
+        .write("lib/accessor_metadata.rb", EXECUTABLE)
+}
+
+#[test]
+fn reduced_metadata_accessors_preserve_original_and_lowered_values() {
+    let (emitted, typed, errors) = app().emit_with_app(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:#?}");
+    fn closed(expr: &roundhouse::expr::Expr) {
+        assert!(
+            expr.ty.as_ref().is_some_and(|ty| !ty.mentions_unknown()),
+            "{expr:#?}"
+        );
+        expr.node.for_each_child(&mut closed);
+    }
+    for method in &typed
+        .library_classes
+        .iter()
+        .find(|class| class.name.0.as_str() == "AccessorMetadata")
+        .unwrap()
+        .methods
+    {
+        closed(&method.body);
+    }
+    let original = emit_and_run::ruby()
+        .args(["-e", &format!("{EXECUTABLE}\nAccessorMetadata.exercise")])
+        .output()
+        .unwrap();
+    let lowered = emit_and_run::ruby()
+        .args([
+            "-e",
+            "require_relative 'app/models'; AccessorMetadata.exercise",
+        ])
+        .current_dir(&*emitted)
+        .output()
+        .unwrap();
+    assert!(
+        original.status.success(),
+        "{}",
+        String::from_utf8_lossy(&original.stderr)
+    );
+    assert!(
+        lowered.status.success(),
+        "{}",
+        String::from_utf8_lossy(&lowered.stderr)
+    );
+    assert_eq!(lowered.stdout, original.stdout);
+}
+
+#[test]
+#[ignore = "requires Spinel; no external services"]
+fn reduced_metadata_accessors_run_natively() {
+    let (emitted, errors) = app().emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:#?}");
+    std::fs::write(
+        emitted.join("probe.rb"),
+        "require_relative 'app/models'; AccessorMetadata.exercise\n",
+    )
+    .unwrap();
+    let compiled =
+        std::process::Command::new(std::env::var("SPINEL").unwrap_or_else(|_| "spinel".into()))
+            .args(["--jobs=4", "--rbs", ".", "probe.rb", "-o", "probe"])
+            .current_dir(&*emitted)
+            .output()
+            .unwrap();
+    assert!(
+        compiled.status.success(),
+        "{}",
+        String::from_utf8_lossy(&compiled.stderr)
+    );
+    let native = std::process::Command::new(emitted.join("probe"))
+        .current_dir(&*emitted)
+        .output()
+        .unwrap();
+    assert!(
+        native.status.success(),
+        "{}",
+        String::from_utf8_lossy(&native.stderr)
+    );
+    assert_eq!(native.stdout, b"source finite accessor PASS\n");
+}
diff --git a/tests/literal_declaration_callbacks.rs b/tests/literal_declaration_callbacks.rs
new file mode 100644
index 000000000..6058ad7fa
--- /dev/null
+++ b/tests/literal_declaration_callbacks.rs
@@ -0,0 +1,183 @@
+//! Literal blocks passed through a guarded root-class factory must retain
+//! Ruby's current-frame block semantics and execute only declaration effects.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const SOURCE: &str = r##"class FilteredEntriesRegistry
+  @@events = []
+
+  def self.register(name)
+    return if respond_to?(name)
+    @@events << name
+    define_singleton_method(name) do
+      instance_variable_get(:"@#{name}") || instance_variable_set(:"@#{name}", [-1, 2, 3])
+    end
+    define_method(name) { self.class.public_send(name) }
+    yield(self) if block_given?
+  end
+
+  def self.filtered(name)
+    return if respond_to?(name)
+    register(name)
+    singleton_class.alias_method(:"_raw_#{name}", name)
+    define_singleton_method(name) { public_send(:"_raw_#{name}").select { |v| v > 0 } }
+    yield(self) if block_given?
+  end
+
+  def self.events
+    @@events
+  end
+
+  filtered(:entries) do |singleton|
+    singleton.define_singleton_method("lookup") { public_send(:_raw_entries) }
+    singleton.define_singleton_method("owner_class") { singleton }
+  end
+
+  filtered(:entries) do |singleton|
+    singleton.define_singleton_method("alternate_lookup") { :wrong }
+  end
+end
+
+class ChildFilteredEntriesRegistry < FilteredEntriesRegistry
+end
+"##;
+
+const PROBE: &str = r#"
+raw = FilteredEntriesRegistry._raw_entries
+raise "filtered values" unless FilteredEntriesRegistry.entries == [2, 3]
+raise "lookup callback not installed on yielded singleton" unless FilteredEntriesRegistry.respond_to?(:lookup)
+raise "lookup does not return cached raw value" unless FilteredEntriesRegistry.lookup.equal?(raw)
+raise "raw cache identity changed" unless raw.equal?(FilteredEntriesRegistry._raw_entries)
+raw << 4
+raise "filtered method lost raw-cache mutation" unless FilteredEntriesRegistry.entries == [2, 3, 4]
+raise "instance shortcut" unless FilteredEntriesRegistry.new.entries == [2, 3, 4]
+raise "duplicate registration or callback ran" unless FilteredEntriesRegistry.events == [:entries]
+raise "duplicate callback installed an alternate method" if FilteredEntriesRegistry.respond_to?(:alternate_lookup)
+raise "owner_class was not bound to the declaring root" unless ChildFilteredEntriesRegistry.owner_class.equal?(FilteredEntriesRegistry)
+child_raw = ChildFilteredEntriesRegistry._raw_entries
+raise "inherited getter did not rebind self" if child_raw.equal?(raw)
+child_raw << 5
+raise "subclass getter did not use subclass state" unless ChildFilteredEntriesRegistry.entries == [2, 3, 5]
+raise "subclass mutation changed root cache" unless FilteredEntriesRegistry.entries == [2, 3, 4]
+puts "literal declaration callback PASS"
+"#;
+
+fn app(source: &str) -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("lib/filtered_entries_registry.rb", source)
+}
+
+fn original_ruby(source: &str, probe: &str) -> std::process::Output {
+    emit_and_run::ruby()
+        .args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("{source}\n{probe}"))
+        .output()
+        .expect("run original CRuby control")
+}
+
+fn emitted_ruby(source: &str, probe: &str) -> std::process::Output {
+    let (emitted, errors) = app(source).emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:#?}");
+    emit_and_run::ruby()
+        .args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("require_relative 'app/models/filtered_entries_registry'\nrequire_relative 'app/models/child_filtered_entries_registry'\n{probe}"))
+        .current_dir(&*emitted)
+        .output()
+        .expect("run emitted Ruby control")
+}
+
+#[test]
+fn literal_callback_keeps_current_block_frame_and_installs_once() {
+    let original = original_ruby(SOURCE, PROBE);
+    assert!(original.status.success(), "{}", String::from_utf8_lossy(&original.stderr));
+    assert_eq!(String::from_utf8_lossy(&original.stdout), "literal declaration callback PASS\n");
+
+    let lowered = emitted_ruby(SOURCE, PROBE);
+    assert!(
+        lowered.status.success(),
+        "{}\n{}",
+        String::from_utf8_lossy(&lowered.stdout),
+        String::from_utf8_lossy(&lowered.stderr)
+    );
+    assert_eq!(String::from_utf8_lossy(&lowered.stdout), "literal declaration callback PASS\n");
+}
+
+#[test]
+fn callback_side_effects_and_unproved_block_shapes_remain_refused() {
+    // These sources are emitted only; callback I/O is never executed.
+    let io_effect = SOURCE.replace(
+        "    singleton.define_singleton_method(\"lookup\") { public_send(:_raw_entries) }",
+        "    File.write(\"should_not_run\", \"called\")\n    singleton.define_singleton_method(\"lookup\") { public_send(:_raw_entries) }",
+    );
+    let opaque_effect = SOURCE.replace(
+        "    singleton.define_singleton_method(\"lookup\") { public_send(:_raw_entries) }",
+        "    perform_unknown_callback_effect(singleton)\n    singleton.define_singleton_method(\"lookup\") { public_send(:_raw_entries) }",
+    );
+    let return_in_callback = SOURCE.replace(
+        "    singleton.define_singleton_method(\"lookup\") { public_send(:_raw_entries) }",
+        "    return :not_a_declaration\n    singleton.define_singleton_method(\"lookup\") { public_send(:_raw_entries) }",
+    );
+    let break_in_callback = SOURCE.replace(
+        "    singleton.define_singleton_method(\"lookup\") { public_send(:_raw_entries) }",
+        "    break\n    singleton.define_singleton_method(\"lookup\") { public_send(:_raw_entries) }",
+    );
+    let non_declaration_callback = SOURCE.replace(
+        "    singleton.define_singleton_method(\"lookup\") { public_send(:_raw_entries) }",
+        "    singleton.instance_variable_set(:@observed, true)\n    singleton.define_singleton_method(\"lookup\") { public_send(:_raw_entries) }",
+    );
+    let wrong_yield_arity = SOURCE.replace(
+        "filtered(:entries) do |singleton|",
+        "filtered(:entries) do |singleton, extra|",
+    );
+    let wrong_yield_arguments = SOURCE.replace("yield(self)", "yield(self, self)");
+    let splatted_yield = SOURCE.replace("yield(self)", "yield(*self)");
+    let block_locals = SOURCE.replace("do |singleton|", "do |singleton; local|");
+    let destructured_callback = SOURCE.replace("do |singleton|", "do |(singleton)|");
+    let optional_callback = SOURCE.replace("do |singleton|", "do |singleton = nil|");
+    let unsupported_block_params = SOURCE.replace(
+        "filtered(:entries) do |singleton|",
+        "filtered(:entries) do |*singleton|",
+    );
+    let custom_block_given = SOURCE.replace(
+        "  def self.register(name)\n",
+        "  def self.block_given?; false; end\n\n  def self.register(name)\n",
+    );
+    let custom_singleton_context = SOURCE.replace(
+        "  def self.filtered(name)\n",
+        "  def self.singleton_class; self; end\n\n  def self.filtered(name)\n",
+    );
+    let lifecycle_callback = SOURCE.replace(
+        "  def self.register(name)\n",
+        "  def self.singleton_method_added(name)\n    @@events << name\n  end\n\n  def self.register(name)\n",
+    );
+
+    for (case, source) in [
+        ("callback I/O", io_effect),
+        ("opaque callback effect", opaque_effect),
+        ("return in callback", return_in_callback),
+        ("break in callback", break_in_callback),
+        ("non-declaration callback statement", non_declaration_callback),
+        ("wrong callback arity", wrong_yield_arity),
+        ("wrong yield argument count", wrong_yield_arguments),
+        ("splatted yield arguments", splatted_yield),
+        ("block-local declaration", block_locals),
+        ("destructured callback parameter", destructured_callback),
+        ("optional callback parameter", optional_callback),
+        ("unsupported block parameters", unsupported_block_params),
+        ("custom block_given?", custom_block_given),
+        ("custom singleton context", custom_singleton_context),
+        ("singleton lifecycle callback", lifecycle_callback),
+    ] {
+        let (_, errors) = app(&source).emit(roundhouse::project::BuildTarget::Spinel);
+        assert!(!errors.is_empty(), "unproved {case} unexpectedly emitted without errors");
+    }
+}
+
+#[test]
+#[ignore = "requires Spinel; no external services"]
+fn literal_declaration_callbacks_run_natively_with_emitted_rbs() {
+    let run = app(SOURCE).run_spinel_with_rbs(PROBE);
+    run.assert_passes();
+    assert_eq!(run.stdout, "literal declaration callback PASS\n");
+}
diff --git a/tests/plain_typed_symbol_hash_key.rs b/tests/plain_typed_symbol_hash_key.rs
new file mode 100644
index 000000000..40f2c0b3c
--- /dev/null
+++ b/tests/plain_typed_symbol_hash_key.rs
@@ -0,0 +1,70 @@
+//! A Symbol's static type must not turn a plain Hash into an indifferent
+//! store. Same contract as plain_string_hash_key, including typed keys.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const SOURCE: &str = r#"module TypedPlainKeys
+  #: (Hash[String, untyped], Symbol) -> untyped
+  def self.read(values, key)
+    values[key]
+  end
+  #: (Hash[String, untyped], Symbol) -> untyped
+  def self.fetch(values, key)
+    values.fetch(key, :absent)
+  end
+  #: (Hash[String, untyped], Symbol) -> bool
+  def self.has(values, key)
+    values.key?(key)
+  end
+  #: (Hash[String, untyped], Symbol) -> untyped
+  def self.remove(values, key)
+    values.delete(key)
+  end
+  #: (Hash[String, untyped], Symbol, Integer) -> Integer
+  def self.store(values, key, value)
+    values[key] = value
+  end
+  #: (Hash[String, untyped], Symbol) -> untyped
+  def self.nested(values, key)
+    values.dig(key, :leaf)
+  end
+end
+"#;
+
+const PROBE: &str = r#"
+values = { "x" => 1, x: 2 }
+raise "typed Symbol read coerced" unless TypedPlainKeys.read(values, :x) == 2
+raise "typed Symbol fetch coerced" unless TypedPlainKeys.fetch(values, :x) == 2
+raise "typed Symbol presence" unless TypedPlainKeys.has(values, :x)
+raise "typed Symbol delete coerced" unless TypedPlainKeys.remove(values, :x) == 2
+raise "String entry was changed" unless values["x"] == 1
+raise "missing Symbol became String hit" unless TypedPlainKeys.read(values, :x).nil?
+raise "fetch miss" unless TypedPlainKeys.fetch(values, :x) == :absent
+raise "presence miss" if TypedPlainKeys.has(values, :x)
+TypedPlainKeys.store(values, :x, 3)
+raise "Symbol store coerced" unless values[:x] == 3 && values["x"] == 1
+nested = { "nest" => { leaf: 10 }, nest: { leaf: 20 } }
+raise "dig coerced" unless TypedPlainKeys.nested(nested, :nest) == 20
+puts "plain typed Hash keys PASS"
+"#;
+
+fn app() -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("lib/typed_plain_keys.rb", SOURCE)
+}
+
+#[test]
+fn typed_symbol_keys_keep_plain_hash_semantics_on_emitted_ruby() {
+    let run = app().run_ruby(PROBE);
+    run.assert_passes();
+    assert_eq!(run.stdout, "plain typed Hash keys PASS\n");
+}
+
+#[test]
+#[ignore = "requires Spinel; no external services"]
+fn typed_symbol_keys_keep_plain_hash_semantics_natively() {
+    let run = app().run_spinel_with_rbs(PROBE);
+    run.assert_passes();
+    assert_eq!(run.stdout, "plain typed Hash keys PASS\n");
+}
diff --git a/tests/plugin_app_roots.rs b/tests/plugin_app_roots.rs
new file mode 100644
index 000000000..47a9d52df
--- /dev/null
+++ b/tests/plugin_app_roots.rs
@@ -0,0 +1,127 @@
+//! Discourse plugins are selected by plugin.rb, independently of PATH gems.
+//! Boot DSLs and mounting remain explicit gaps, not claims of runtime support.
+
+use std::path::PathBuf;
+
+use roundhouse::ingest::{ingest_app_from_tree, survey};
+
+fn tree(files: &[(&str, &str)]) -> roundhouse::vfs::FileTree {
+    files.iter().map(|(path, text)| (PathBuf::from(path), text.as_bytes().to_vec())).collect()
+}
+
+fn surveyed(files: &[(&str, &str)]) -> (roundhouse::App, Vec<String>) {
+    survey::activate();
+    let result = ingest_app_from_tree(tree(files));
+    let gaps = survey::drain().into_iter().map(|gap| gap.to_string()).collect();
+    (result.expect("plugin survey must recover"), gaps)
+}
+
+#[test]
+fn plugin_app_layers_and_sibling_library_are_ingested_once() {
+    let (app, gaps) = surveyed(&[
+        ("db/schema.rb", "ActiveRecord::Schema.define do\n  create_table :foos do |t|\n    t.string :title\n  end\nend\n"),
+        ("app/models/application_record.rb", "class ApplicationRecord < ActiveRecord::Base\n  self.abstract_class = true\nend\n"),
+        ("app/controllers/application_controller.rb", "class ApplicationController < ActionController::Base\nend\n"),
+        ("plugins/foo/plugin.rb", "enabled_site_setting :foo_enabled\nmodule FooPlugin\n  def self.name\n    'foo'\n  end\nend\n"),
+        ("plugins/foo/app/models/foo.rb", "class Foo < ApplicationRecord\nend\n"),
+        ("plugins/foo/app/controllers/foos_controller.rb", "class FoosController < ApplicationController\n  def index\n    @foos = Foo.all\n  end\nend\n"),
+        ("plugins/foo/app/views/foos/index.html.erb", "<h1>Foos</h1>"),
+        ("plugins/foo/app/serializers/foo_serializer.rb", "class FooSerializer\n  def title\n    'foo'\n  end\nend\n"),
+        ("plugins/foo/lib/foo_tool.rb", "class FooTool\n  def self.call\n    1\n  end\nend\n"),
+        ("plugins/not_a_plugin/app/models/ignored.rb", "class Ignored < ApplicationRecord\nend\n"),
+    ]);
+    assert_eq!(app.app_roots, vec!["app", "plugins/foo/app"]);
+    assert_eq!(app.models.iter().filter(|model| model.name.0.as_str() == "Foo").count(), 1);
+    assert!(!app.models.iter().any(|model| model.name.0.as_str() == "Ignored"));
+    assert_eq!(app.controllers.iter().filter(|controller| controller.name.0.as_str() == "FoosController").count(), 1);
+    assert!(app.views.iter().any(|view| view.name.as_str() == "foos/index"));
+    for name in ["FooPlugin", "FooSerializer", "FooTool"] {
+        assert_eq!(app.library_classes.iter().filter(|class| class.name.0.as_str() == name).count(), 1, "{name}");
+    }
+    assert!(gaps.iter().any(|gap| gap.contains("plugin.rb DSL not modeled: enabled_site_setting")), "{gaps:?}");
+}
+
+#[test]
+fn lib_only_plugins_contribute_libraries_and_marker_only_plugins_still_survey() {
+    let (app, gaps) = surveyed(&[
+        ("plugins/lib_only/plugin.rb", "# metadata only\n"),
+        ("plugins/lib_only/lib/tool.rb", "module PluginTool\n  def self.call\n    1\n  end\nend\n"),
+        ("plugins/assets_only/plugin.rb", "register_asset 'foo.scss'\n"),
+        ("plugins/assets_only/assets/foo.scss", "body {}"),
+        ("plugins/missing_marker/lib/ignored.rb", "class Ignored\nend\n"),
+    ]);
+    assert_eq!(app.app_roots, vec!["app", "plugins/lib_only/app"]);
+    assert!(app.library_classes.iter().any(|class| class.name.0.as_str() == "PluginTool"));
+    assert!(!app.library_classes.iter().any(|class| class.name.0.as_str() == "Ignored"));
+    assert!(gaps.iter().any(|gap| gap.contains("plugins/assets_only/plugin.rb") && gap.contains("plugin.rb DSL not modeled: register_asset")), "{gaps:?}");
+}
+
+#[test]
+fn plugin_boot_dsl_is_inventoried_per_construct_even_in_nested_blocks() {
+    let (_, gaps) = surveyed(&[("plugins/foo/plugin.rb", r#"
+# register_fake is just a comment, not a construct.
+register_asset "foo.scss"
+register_asset "bar.scss"
+after_initialize do
+  add_to_serializer(:topic, :foo) { object.foo }
+  self.on(:event) do
+    add_to_class(:topic, :foo) { true }
+  end
+  Discourse::Application.routes.append { mount Foo::Engine, at: "/foo" }
+end
+module FooPlugin
+  def self.ordinary_method
+    not_a_boot_call
+  end
+end
+"#)]);
+    for name in ["register_asset", "after_initialize", "add_to_serializer", "on", "add_to_class", "mount"] {
+        let needle = format!("plugin.rb DSL not modeled: {name}");
+        assert_eq!(gaps.iter().filter(|gap| gap.contains(&needle)).count(), 1, "{gaps:?}");
+    }
+    assert!(gaps.iter().any(|gap| gap.contains("plugin.rb boot call not modeled: append")), "{gaps:?}");
+    assert!(!gaps.iter().any(|gap| gap.contains("DSL not modeled: not_a_boot_call") || gap.contains("register_fake")), "{gaps:?}");
+}
+
+#[test]
+fn plugin_dsl_is_not_silently_accepted_in_strict_mode() {
+    let result = ingest_app_from_tree(tree(&[("plugins/foo/plugin.rb", "register_asset 'foo.scss'\n")]));
+    let error = result.expect_err("unmodeled plugin boot DSL must block strict ingest").to_string();
+    assert!(error.contains("plugin.rb DSL not modeled: register_asset"), "{error}");
+}
+
+#[test]
+fn plugin_routes_are_surveyed_but_never_installed_at_host_root() {
+    let (app, gaps) = surveyed(&[
+        ("config/routes.rb", "Rails.application.routes.draw do\n  get '/host', to: 'host#index'\nend\n"),
+        ("plugins/foo/plugin.rb", "# metadata\n"),
+        ("plugins/foo/lib/foo/engine.rb", "module Foo\n  class Engine < ::Rails::Engine\n    engine_name 'foo'\n    isolate_namespace Foo\n  end\nend\n"),
+        ("plugins/foo/config/routes.rb", "Foo::Engine.routes.draw do\n  get '/only_in_plugin', to: 'foos#index'\n  authenticate :user do\n    get '/private', to: 'foos#private'\n  end\nend\n"),
+    ]);
+    assert!(gaps.iter().any(|gap| gap.contains("plugins/foo/config/routes.rb") && gap.contains("plugin foo: engine route mounting not modeled")), "{gaps:?}");
+    assert!(gaps.iter().any(|gap| gap.contains("authenticate")), "route DSL must actually be ingested: {gaps:?}");
+    let routes = format!("{:?}", app.routes);
+    assert!(routes.contains("/host"), "{routes}");
+    assert!(!routes.contains("only_in_plugin") && !routes.contains("/private"), "engine paths leaked into host: {routes}");
+}
+
+#[test]
+fn plugin_migrations_remain_a_named_schema_gap() {
+    let (app, gaps) = surveyed(&[
+        ("plugins/foo/plugin.rb", "# metadata\n"),
+        ("plugins/foo/db/migrate/001_create_foos.rb", "class CreateFoos < ActiveRecord::Migration[8.0]\n  def change\n    create_table :foos\n  end\nend\n"),
+    ]);
+    assert!(gaps.iter().any(|gap| gap.contains("plugins/foo/db/migrate") && gap.contains("plugin foo: migration schema not ingested")), "{gaps:?}");
+    assert!(!format!("{:?}", app.schema).contains("foos"));
+}
+
+#[test]
+fn malformed_plugin_entrypoint_reports_parse_error_and_keeps_other_roots() {
+    let ((app, _), diagnostics) = roundhouse::ingest::prism::scope(|| surveyed(&[
+        ("plugins/broken/plugin.rb", "register_asset (\n"),
+        ("plugins/okay/plugin.rb", "# metadata\n"),
+        ("plugins/okay/lib/okay.rb", "class Okay\nend\n"),
+    ]));
+    assert!(app.library_classes.iter().any(|class| class.name.0.as_str() == "Okay"));
+    assert!(!diagnostics.is_empty(), "malformed plugin must retain parse diagnostics");
+}
diff --git a/tests/postgresql_spinel_target.rs b/tests/postgresql_spinel_target.rs
new file mode 100644
index 000000000..f7b47e9de
--- /dev/null
+++ b/tests/postgresql_spinel_target.rs
@@ -0,0 +1,102 @@
+//! PostgreSQL selection on Spinel, without creating/seeding any database.
+//! The optional native case uses only VALUES/SELECT in a read-only transaction.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+use roundhouse::project::BuildTarget;
+use std::process::Command;
+
+fn app() -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/database.yml", "test:\n  adapter: postgresql\n  database: probe\n")
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("db/schema.rb", "ActiveRecord::Schema.define do\n  create_table \"widgets\" do |t|\n    t.string \"name\"\n    t.boolean \"active\"\n    t.float \"score\", null: false\n  end\nend\n")
+        .write("app/models/widget.rb", "class Widget < ActiveRecord::Base\n  scope :active, -> { where(active: true) }\nend\n")
+}
+
+fn read(root: &std::path::Path, path: &str) -> String {
+    std::fs::read_to_string(root.join(path)).unwrap_or_else(|e| panic!("{path}: {e}"))
+}
+
+#[test]
+fn postgresql_spinel_selects_native_driver_dialect_and_signatures() {
+    let (tree, errors) = app().emit(BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:?}");
+    assert!(read(&tree, "runtime/db.rb").contains("Primitive Db surface over PostgreSQL"));
+    assert!(read(&tree, "runtime/pg_driver.rb").contains("PG.connect(host, port, database, user, password)"));
+    assert!(!tree.join("runtime/pg_driver_cruby.rb").exists());
+    assert!(read(&tree, "runtime/pg_errors.rb").contains("StatementInvalid"));
+    assert!(read(&tree, "spin.toml").contains("pg = \"0.2.0\""));
+    assert!(read(&tree, "runtime/db.rbs").contains("class PgConfig"));
+    assert!(read(&tree, "runtime/pg_driver.rbs").contains("PgClientCore"));
+    assert!(read(&tree, "config/schema.rb").contains("bigserial PRIMARY KEY"));
+    assert!(read(&tree, "main.rb").contains("ENV.fetch(\"DATABASE_URL\", \"\")"));
+    // Do not silently run the SQLite test helper on a shared PG database.
+    assert!(read(&tree, "test/test_helper.rb").contains("native PostgreSQL test database isolation is not implemented"));
+    let widget = read(&tree, "app/models/widget.rb");
+    assert!(!widget.contains("WHERE id = ?"), "SQLite placeholders in PG readers");
+    assert!(widget.contains("Db.escape_string(@score.to_s)"), "Float passed to String Db slot:\n{widget}");
+}
+
+#[test]
+fn sqlite_function_registration_is_refused_for_spinel_postgresql() {
+    let (_tree, errors) = app()
+        .write("config/initializers/sqlite.rb", "conn.create_function(\"regexp\", 2) do |fn, pattern, expr|\n  fn.result = 1\nend\n")
+        .emit(BuildTarget::Spinel);
+    assert!(errors.iter().any(|e| e.contains("SQLite functions") && e.contains("postgresql")), "{errors:?}");
+}
+
+#[test]
+#[ignore = "requires Spinel, SPINEL_PG_DIR, pg gem and ROUNDHOUSE_PG_READONLY_URL; SELECT only"]
+fn native_postgresql_values_and_types_match_the_same_ruby_on_cruby() {
+    let url = std::env::var("ROUNDHOUSE_PG_READONLY_URL").expect("explicit read-only PG URL required");
+    let pg_dir = std::env::var("SPINEL_PG_DIR").expect("SPINEL_PG_DIR required");
+    let compiler = std::env::var("SPINEL").unwrap_or_else(|_| "spinel".into());
+    let (tree, errors) = app().emit(BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:?}");
+    let script = r##"# frozen_string_literal: true
+require_relative "runtime/sqlite_adapter"
+require_relative "runtime/db"
+require_relative "runtime/active_support_ext"
+require_relative "runtime/active_support_duration"
+require_relative "runtime/active_record"
+require_relative "app/models"
+Db.configure(ENV.fetch("ROUNDHOUSE_PG_READONLY_URL"), pool_size: 2)
+ActiveRecord.adapter = SqliteAdapter
+2.times do |index|
+  connection = Db.pool.conn(index)
+  raise "new pool path is writable" unless connection.client.exec("SHOW default_transaction_read_only").getvalue(0, 0) == "on"
+  connection.drop
+  raise "reopened pool path is writable" unless connection.client.exec("SHOW default_transaction_read_only").getvalue(0, 0) == "on"
+end
+Db.exec("BEGIN READ ONLY")
+query = Widget.from("(VALUES (1, 'O''Reilly?'::text, TRUE, 1.25::float8), (2, 'hidden', FALSE, -2.5::float8), (3, NULL, NULL, 3.5::float8)) AS widgets(id,name,active,score)")
+log = Db.capture_sql { query.order(:id).to_a.each { |w| puts "#{w.id}|#{w.name.inspect}|#{w.active.inspect}|#{w.score}" } }
+raise "read count" unless log.length == 1
+raise "boolean predicate" unless query.where(active: true).to_a.length == 1
+raise "NULL predicate" unless query.where(active: nil).to_a.length == 1
+# Non-null Float write serialization must be statically well-typed even
+# though this read-only test never calls save or emits a write to the DB.
+Db.exec("ROLLBACK")
+Db.close
+"##;
+    std::fs::write(tree.join("pg_readonly.rb"), script).unwrap();
+    let compiled = Command::new(&compiler)
+        .args(["--rbs", ".", "-I", &pg_dir, "pg_readonly.rb", "-o", "pg_readonly"])
+        .current_dir(&*tree).output().expect("compile Spinel");
+    assert!(compiled.status.success(), "{}", String::from_utf8_lossy(&compiled.stderr));
+    let native = Command::new(tree.join("pg_readonly")).current_dir(&*tree)
+        .env("ROUNDHOUSE_PG_READONLY_URL", &url).env("DATABASE_READONLY", "1").env("DATABASE_POOL_SIZE", "2").output().expect("run native");
+    assert!(native.status.success(), "{}", String::from_utf8_lossy(&native.stderr));
+    // Exactly the same emitted Ruby and entry script, only the platform PG
+    // connection shim changes from spinel-pg to the gem's keyword API.
+    std::fs::write(tree.join("runtime/pg_driver.rb"), std::fs::read("runtime/spinel/pg_driver_cruby.rb").unwrap()).unwrap();
+    let compat = Command::new("ruby").args(["--enable-frozen-string-literal", "pg_readonly.rb"])
+        .current_dir(&*tree).env("ROUNDHOUSE_PG_READONLY_URL", &url)
+        .env("DATABASE_READONLY", "1").env("DATABASE_POOL_SIZE", "2")
+        .env("PGOPTIONS", "-c default_transaction_read_only=on -c statement_timeout=15000")
+        .output().expect("run compatibility Ruby");
+    assert!(compat.status.success(), "{}", String::from_utf8_lossy(&compat.stderr));
+    assert_eq!(native.stdout, compat.stdout);
+    assert_eq!(String::from_utf8_lossy(&native.stdout), "1|\"O'Reilly?\"|true|1.25\n2|\"hidden\"|false|-2.5\n3|nil|nil|3.5\n");
+}
diff --git a/tests/projected_null_reads.rs b/tests/projected_null_reads.rs
new file mode 100644
index 000000000..28048f800
--- /dev/null
+++ b/tests/projected_null_reads.rs
@@ -0,0 +1,79 @@
+//! Raw FROM rows can null physically NOT NULL attributes. Keep that distinct
+//! from the DDL constraint and exercise identical emitted/native scalar reads.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+fn app() -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("db/schema.rb", "ActiveRecord::Schema.define do\n  create_table \"samples\" do |t|\n    t.boolean \"active\", null: false\n    t.integer \"quantity\", null: false\n    t.float \"score\", null: false\n    t.string \"label\", null: false\n  end\n  create_table \"identities\" do |t|\n  end\nend\n")
+        .write("app/models/identity.rb", "class Identity < ActiveRecord::Base\nend\n")
+        .write("app/models/sample.rb", r#"class Sample < ActiveRecord::Base
+  def self.projected
+    from("(SELECT 1 AS id, NULL AS active, NULL AS quantity, NULL AS score, NULL AS label UNION ALL SELECT 2, 0, 0, 0.0, '' UNION ALL SELECT 3, 1, 7, 1.25, 'yes') AS samples").order("samples.id ASC")
+  end
+end
+"#)
+}
+
+const PROBE: &str = r#"
+relation = nil
+compose = Db.capture_sql { relation = Sample.projected }
+raise "not lazy" unless compose.empty?
+rows = relation.to_a
+raise "rows" unless rows.length == 3
+raise "NULL boolean" unless rows[0].active.nil?
+raise "NULL integer" unless rows[0].quantity.nil?
+raise "NULL float" unless rows[0].score.nil?
+raise "NULL text" unless rows[0].label.nil?
+raise "false was nil" unless rows[1].active == false && !rows[1].active.nil?
+raise "zero" unless rows[1].quantity == 0 && rows[1].score == 0.0
+raise "empty text" unless rows[1].label == ""
+raise "values" unless rows[2].active == true && rows[2].quantity == 7 && rows[2].score == 1.25 && rows[2].label == "yes"
+raise "scalar types" unless rows[1].id.is_a?(Integer) && rows[1].quantity.is_a?(Integer) && rows[1].score.is_a?(Float) && rows[1].label.is_a?(String) && rows[1].active.is_a?(FalseClass) && rows[2].active.is_a?(TrueClass)
+repeat = Db.capture_sql { relation.to_a }
+raise "cache" unless repeat.empty?
+hash_record = Sample.instantiate({"id" => "4", "active" => nil, "quantity" => nil, "score" => nil, "label" => nil})
+raise "Hash-row NULLs" unless hash_record.id == 4 && hash_record.active.nil? && hash_record.quantity.nil? && hash_record.score.nil? && hash_record.label.nil?
+# Physical NOT NULL is not weakened by the read-shape metadata.
+raise "DDL lost NOT NULL" unless Schema.statements.join.include?("active BOOLEAN NOT NULL") || Schema.statements.join.include?("active INTEGER NOT NULL")
+begin
+  Db.exec("INSERT INTO samples (active, quantity, score, label) VALUES (NULL, 1, 1.0, 'invalid')")
+  raise "physical constraint accepted NULL"
+rescue StandardError => error
+  raise "physical constraint failure was not NOT NULL: #{error.message}" unless error.message.include?("NOT NULL constraint failed")
+end
+begin
+  Sample.projected.from("(SELECT NULL AS id, NULL AS active, NULL AS quantity, NULL AS score, NULL AS label) AS samples").to_a
+  raise "NULL identity became a fabricated record"
+rescue NotImplementedError
+end
+begin
+  Sample.instantiate({"id" => nil, "active" => nil, "quantity" => nil, "score" => nil, "label" => nil})
+  raise "NULL Hash-row identity became a fabricated record"
+rescue NotImplementedError
+end
+begin
+  Identity.from("(SELECT NULL AS id) AS identities").to_a
+  raise "NULL identity in an id-only schema became a fabricated record"
+rescue NotImplementedError
+end
+puts "projected NULLs preserved"
+"#;
+
+#[test]
+fn projected_nulls_run_on_emitted_ruby() {
+    let result = app().run_ruby(PROBE);
+    result.assert_passes();
+    assert_eq!(result.stdout, "projected NULLs preserved\n");
+}
+
+#[test]
+#[ignore = "requires Spinel"]
+fn projected_nulls_run_natively() {
+    let result = app().run_spinel_with_rbs(&format!(
+        "Db.configure(\":memory:\")\nSchema.statements.each {{ |sql| Db.exec(sql) }}\nActiveRecord.adapter = SqliteAdapter\n{PROBE}"
+    ));
+    result.assert_passes();
+    assert_eq!(result.stdout, "projected NULLs preserved\n");
+}
diff --git a/tests/rbs_singleton_object.rs b/tests/rbs_singleton_object.rs
new file mode 100644
index 000000000..877848986
--- /dev/null
+++ b/tests/rbs_singleton_object.rs
@@ -0,0 +1,49 @@
+//! RBS singleton values must preserve the class-object ABI through callable
+//! fields and nested lexical scopes, never become nominal instance pointers.
+use roundhouse::ty::Ty;
+use roundhouse::{ClassId, Symbol};
+#[test]
+fn nested_singleton_parameters_and_callable_fields_keep_root_owner() {
+    let source = "module RuntimeStore\n  class Entry\n    def invoke: (singleton(::Owner) receiver, ^(singleton(::Owner)) -> Integer body) -> singleton(::Owner)\n  end\nend\n";
+    let signatures = roundhouse::rbs::parse_app_signatures(source).unwrap();
+    let Ty::Fn { params, ret, .. } =
+        &signatures[&ClassId(Symbol::from("RuntimeStore::Entry"))][&Symbol::from("invoke")]
+    else {
+        panic!("function signature")
+    };
+    let expected = Ty::Class {
+        id: ClassId(Symbol::from("Class")),
+        args: vec![Ty::Class {
+            id: ClassId(Symbol::from("Owner")),
+            args: vec![].into(),
+        }]
+        .into(),
+    };
+    assert_eq!(*params[0].ty, expected);
+    assert_eq!(**ret, expected);
+    let Ty::Fn {
+        params: captured, ..
+    } = &*params[1].ty
+    else {
+        panic!("typed callable")
+    };
+    assert_eq!(*captured[0].ty, expected);
+}
+#[test]
+fn ordinary_instance_parameters_stay_instances() {
+    let signatures = roundhouse::rbs::parse_app_signatures(
+        "class Owner\n def value: (Owner input) -> Owner\nend\n",
+    )
+    .unwrap();
+    let Ty::Fn { params, ret, .. } =
+        &signatures[&ClassId(Symbol::from("Owner"))][&Symbol::from("value")]
+    else {
+        panic!("function signature")
+    };
+    let expected = Ty::Class {
+        id: ClassId(Symbol::from("Owner")),
+        args: vec![].into(),
+    };
+    assert_eq!(*params[0].ty, expected);
+    assert_eq!(**ret, expected);
+}
diff --git a/tests/referenced_includes_merge.rs b/tests/referenced_includes_merge.rs
new file mode 100644
index 000000000..3a1bc5812
--- /dev/null
+++ b/tests/referenced_includes_merge.rs
@@ -0,0 +1,100 @@
+//! A referenced include can arrive via an argument/merge after includes was
+//! composed. No chain-local rewrite sees both. All writes are SQLite :memory:.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+fn app() -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("db/schema.rb", "ActiveRecord::Schema.define do\n  create_table \"shelves\" do |t|\n    t.string \"name\"\n  end\n  create_table \"books\" do |t|\n    t.string \"title\"\n    t.integer \"shelf_id\"\n  end\nend\n")
+        .write("app/models/shelf.rb", "class Shelf < ActiveRecord::Base\n  has_many :books\nend\n")
+        .write("app/models/book.rb", "class Book < ActiveRecord::Base\n  belongs_to :shelf, optional: true\nend\n")
+        .write("app/models/reference_probe.rb", r#"class ReferenceProbe
+  def self.condition(records, ids)
+    records.where("shelves.id IS NULL OR shelves.id IN (?)", ids).references(:shelves)
+  end
+  def self.relation(ids)
+    Book.includes(:shelf).merge(condition(Book.unscoped, ids))
+  end
+end
+"#)
+}
+
+const PROBE: &str = r#"
+allowed = Shelf.create!(name: "O'Reilly?")
+restricted = Shelf.create!(name: "restricted")
+Book.create!(title: "public", shelf_id: allowed.id)
+Book.create!(title: "restricted", shelf_id: restricted.id)
+Book.create!(title: "null", shelf_id: nil)
+Book.create!(title: "dangling", shelf_id: -987)
+base = Book.includes(:shelf)
+condition = ReferenceProbe.condition(Book.unscoped, [allowed.id])
+relation = nil
+compose = Db.capture_sql { relation = base.merge(condition).order("books.id ASC") }
+raise "not lazy" unless compose.empty?
+raise "lost reference" unless relation.to_sql.include?("LEFT OUTER JOIN shelves")
+raise "mutated receiver" if base.to_sql.include?("JOIN")
+raise "mutated operand" if condition.to_sql.include?("JOIN")
+rows = []
+queries = Db.capture_sql { rows = relation.to_a }
+raise "filter: #{relation.to_sql}; #{rows.map(&:title).inspect}" unless rows.map(&:title) == ["public", "null", "dangling"]
+# Explicitly batch preloaded, not joined-row hydration: parent SELECT + target.
+raise "batch count" unless queries.length == 2
+cached = Db.capture_sql do
+  raise "category" unless rows[0].shelf.name == "O'Reilly?"
+  raise "NULL" unless rows[1].shelf.nil?
+  raise "dangling" unless rows[2].shelf.nil?
+  relation.to_a
+end
+raise "preload/memo" unless cached.empty?
+raise "callee composition" unless ReferenceProbe.relation([restricted.id]).order("books.id ASC").to_a.map(&:title) == ["restricted", "null", "dangling"]
+fork = relation.references(:unknown)
+raise "fork reference list shared" unless relation.reference_values == ["shelves"] && fork.reference_values == ["shelves", "unknown"]
+raise "unrelated reference changed SQL" unless fork.to_sql == relation.to_sql
+# Caller-owned arrays returned by the metadata reader cannot mutate the scope.
+values = condition.reference_values
+values.clear
+raise "reference_values exposed state" unless relation.to_sql.include?("LEFT OUTER JOIN shelves")
+# Preload must not become a join merely because references is present.
+raise "preload joined" if Book.preload(:shelf).references(:shelves).to_sql.include?("JOIN")
+# Supplying references before includes has the same filtering contract.
+raise "order dependent" unless Book.references("shelves").includes(:shelf).where("shelves.name = ?", "O'Reilly?").to_a.map(&:title) == ["public"]
+raise "duplicate join" unless Book.joins("INNER JOIN shelves ON shelves.id = books.shelf_id").includes(:shelf).references(:shelves).to_sql.scan("JOIN shelves").length == 1
+raise "count" unless relation.where("books.id > ?", 0).count == 3
+raise "pluck" unless relation.pluck(:title) == ["public", "null", "dangling"]
+raise "exists" unless relation.exists?
+raise "positional quoted array" unless Shelf.where("shelves.name IN (?)", ["O'Reilly?", "' OR TRUE --", "back\\slash?"]).to_a.map(&:id) == [allowed.id]
+raise "positional empty array" unless Shelf.where("shelves.id IN (?)", []).to_a.empty?
+raise "named empty array" unless Shelf.where("shelves.id IN (:ids)", ids: []).to_a.empty?
+raise "NULL list member" unless Shelf.where("shelves.id IN (?)", [nil, allowed.id]).to_a.map(&:id) == [allowed.id]
+begin
+  Book.includes(:shelf).references(:shelf).to_sql
+  raise "alias tracking silently guessed"
+rescue NotImplementedError
+end
+begin
+  # Through an argument so the existing chain-local has_many lowering does
+  # not rewrite this into a different (already supported) representation.
+  ReferenceProbe.condition(Shelf.includes(:books), [allowed.id]).references(:books).to_sql
+  raise "collection silently joined"
+rescue NotImplementedError
+end
+puts "referenced includes preserved"
+"#;
+
+#[test]
+fn referenced_includes_across_merge_run_on_emitted_ruby() {
+    let run = app().run_ruby(PROBE);
+    run.assert_passes();
+    assert_eq!(run.stdout, "referenced includes preserved\n");
+}
+
+#[test]
+#[ignore = "requires Spinel"]
+fn referenced_includes_across_merge_run_natively() {
+    let run = app().run_spinel_with_rbs(&format!(
+        "Db.configure(\":memory:\")\nSchema.statements.each {{ |sql| Db.exec(sql) }}\nActiveRecord.adapter = SqliteAdapter\n{PROBE}"
+    ));
+    run.assert_passes();
+    assert_eq!(run.stdout, "referenced includes preserved\n");
+}
diff --git a/tests/roundtrip.rs b/tests/roundtrip.rs
index 43375a899..1d59f0088 100644
--- a/tests/roundtrip.rs
+++ b/tests/roundtrip.rs
@@ -36,6 +36,7 @@ fn tiny_blog_round_trips() {
                     generated_int4_compatible: None,
                     array: false,
                     array_stored: false,
+                    read_nullable: false,
                 },
