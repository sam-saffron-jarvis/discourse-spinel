+    );
+    let native = std::process::Command::new(emitted.join("scan"))
+        .current_dir(&*emitted)
+        .output()
+        .unwrap();
+    assert!(
+        native.status.success(),
+        "{}",
+        String::from_utf8_lossy(&native.stderr)
+    );
+    assert_eq!(
+        native.stdout,
+        b"source plugin accumulator PASS\nsource plugin registry PASS\n"
+    );
+}
