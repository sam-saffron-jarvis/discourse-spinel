+/// Verify the original outer block header too: destructuring, numbered args
+/// and block locals must not disappear into a simpler Lambda parameter list.
+fn declaration_callback_syntax(call: &Expr, sources: &[SourceFile]) -> bool {
+    let Some(text) = source_text(call.span, sources) else { return false };
+    let parsed = super::prism::parse_silent(text);
+    let Some(program) = parsed.node().as_program_node() else { return false };
+    let nodes: Vec<_> = program.statements().body().iter().collect();
+    let [node] = nodes.as_slice() else { return false };
+    let Some(block) = node.as_call_node().and_then(|call| call.block()).and_then(|block| block.as_block_node()) else { return false };
+    let Some(header) = block.parameters().and_then(|params| params.as_block_parameters_node()) else { return false };
+    let Some(params) = header.parameters() else { return false };
+    let required: Vec<_> = params.requireds().iter().collect();
+    matches!(required.as_slice(), [param] if param.as_required_parameter_node().is_some())
+        && header.locals().iter().next().is_none() && params.optionals().iter().next().is_none()
+        && params.rest().is_none() && params.posts().iter().next().is_none()
+        && params.keywords().iter().next().is_none() && params.keyword_rest().is_none() && params.block().is_none()
+        && definition_syntax_kept(call, sources)
+}
