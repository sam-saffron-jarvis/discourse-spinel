diff --git a/tests/declaration_capture_runtime.rs b/tests/declaration_capture_runtime.rs
new file mode 100644
index 000000000..5a388a4f3
--- /dev/null
+++ b/tests/declaration_capture_runtime.rs
@@ -0,0 +1,140 @@
+//! Runtime declaration captures must retain identity and run at the call,
+//! not at the source offset of the macro's definition. No external services.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const STRINGS: &str = r#"class CapturedStrings
+  def self.declare
+    first = :same.to_s
+    alias_value = first
+    second = :same.to_s
+    define_singleton_method(:first) { first }
+    define_singleton_method(:alias_value) { alias_value }
+    define_singleton_method(:second) { second }
+    [:left, :right].each do |name|
+      value = :same.to_s
+      define_singleton_method(name) { value }
+    end
+  end
+  declare
+end
+"#;
+const STRING_PROBE: &str = r#"
+raise "captured alias lost" unless CapturedStrings.first.equal?(CapturedStrings.alias_value)
+raise "equal text is not object identity" if CapturedStrings.first.equal?(CapturedStrings.second)
+raise "loop evaluations were merged" if CapturedStrings.left.equal?(CapturedStrings.right)
+CapturedStrings.first << "!"
+raise "capture was recreated" unless CapturedStrings.alias_value == "same!"
+raise "independent capture mutated" unless CapturedStrings.second == "same" && CapturedStrings.left == "same"
+puts "capture identity PASS"
+"#;
+const ORDER: &str = r#"class CaptureOrder
+  @reads = 0
+  @phase = :initial
+  def self.declare(name)
+    value = phase
+    define_singleton_method(name) { value }
+  end
+  def self.phase
+    @reads += 1
+    @phase
+  end
+  def self.read_count
+    @reads
+  end
+  @phase = :first
+  declare :first
+  @phase = :second
+  declare :second
+  @phase = :finished
+end
+"#;
+const ORDER_PROBE: &str = r#"
+raise "first capture evaluated out of order" unless CaptureOrder.first == :first
+raise "second capture evaluated out of order" unless CaptureOrder.second == :second
+CaptureOrder.first
+CaptureOrder.second
+raise "capture must evaluate exactly once at each call" unless CaptureOrder.read_count == 2
+raise "class state changed" unless CaptureOrder.phase == :finished
+puts "capture order PASS"
+"#;
+
+fn app(source: &str) -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("lib/captured_values.rb", source)
+}
+
+fn original_ruby(source: &str, probe: &str) {
+    let output = emit_and_run::ruby().args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("{source}\n{probe}")).output().expect("run original Ruby");
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+}
+
+fn lowered_ruby(source: &str, probe: &str) {
+    let (emitted, errors) = app(source).emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:#?}");
+    let file = if source == STRINGS { "captured_strings" } else { "capture_order" };
+    let output = emit_and_run::ruby().args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("require_relative 'app/models/{file}'\n{probe}"))
+        .current_dir(&*emitted).output().expect("run same lowered Ruby");
+    assert!(output.status.success(), "{}\n{}\n{}", emitted.display(),
+        String::from_utf8_lossy(&output.stdout), String::from_utf8_lossy(&output.stderr));
+}
+
+#[test]
+fn strings_preserve_aliases_without_merging_distinct_evaluations() {
+    original_ruby(STRINGS, STRING_PROBE);
+    lowered_ruby(STRINGS, STRING_PROBE);
+    app(STRINGS).run_ruby(STRING_PROBE).assert_passes();
+}
+
+#[test]
+fn runtime_values_are_captured_at_each_declaration_call() {
+    original_ruby(ORDER, ORDER_PROBE);
+    lowered_ruby(ORDER, ORDER_PROBE);
+    app(ORDER).run_ruby(ORDER_PROBE).assert_passes();
+}
+
+#[test]
+fn model_owned_runtime_declarations_remain_refused() {
+    let model = ORDER.replace("class CaptureOrder", "class CaptureOrder < ActiveRecord::Base");
+    let overlay = emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("app/models/capture_order.rb", &model);
+    let (_, errors) = overlay.emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.iter().any(|error| error.contains("runtime-defined method not supported")), "{errors:#?}");
+}
+
+#[test]
+fn targets_without_ordered_class_execution_refuse_runtime_captures() {
+    let (_, errors) = app(STRINGS).emit(roundhouse::project::BuildTarget::Go);
+    assert!(errors.iter().any(|error| error.contains("initializes declaration captures in class-body execution order")), "{errors:#?}");
+}
+
+#[test]
+fn declaration_order_retains_original_definer_spans() {
+    let macro_body = "  def self.declare(name)\n    value = phase\n    define_singleton_method(name) { value }\n  end\n";
+    let parent = format!("class CaptureBase\n{macro_body}end\n");
+    let child = ORDER.replace("class CaptureOrder", "class CaptureOrder < CaptureBase").replace(macro_body, "");
+    let overlay = app(&child).write("lib/capture_base.rb", &parent);
+    let (emitted, lowered, errors) = overlay.emit_with_app(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:#?}");
+    let class = lowered.library_classes.iter().find(|class| class.name.0.as_str() == "CaptureOrder").unwrap();
+    let (_, value) = class.constants.iter().find(|(name, _)| name.as_str().starts_with("ROUNDHOUSE_MACRO_")).unwrap();
+    let step = value.declaration_step().expect("explicit declaration execution site");
+    assert_ne!(value.span.file, step.call.file, "definer provenance was overwritten");
+    assert!(lowered.sources[(value.span.file.0 - 1) as usize].path.ends_with("capture_base.rb"));
+    assert!(lowered.sources[(step.call.file.0 - 1) as usize].path.ends_with("captured_values.rb"));
+    let output = emit_and_run::ruby().args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("require_relative 'app/models/capture_order'\n{ORDER_PROBE}"))
+        .current_dir(&*emitted).output().expect("run inherited declaration");
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+}
+
+#[test]
+#[ignore = "requires Spinel; no external services"]
+fn capture_identity_and_declaration_order_run_natively() {
+    app(STRINGS).run_spinel_with_rbs(STRING_PROBE).assert_passes();
+    app(ORDER).run_spinel_with_rbs(ORDER_PROBE).assert_passes();
+}
diff --git a/tests/declaration_self_capture.rs b/tests/declaration_self_capture.rs
new file mode 100644
index 000000000..8b1d26329
--- /dev/null
+++ b/tests/declaration_self_capture.rs
@@ -0,0 +1,60 @@
+//! A declaration-time self capture is the declaring class object, while a
+//! generated method's uncaptured self follows its eventual receiver.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const SOURCE: &str = r#"class SelfCaptureRegistry
+  def self.declare(name)
+    return if respond_to?(name)
+    declaring = self
+    define_singleton_method(name) { declaring }
+    define_singleton_method(:runtime_receiver) { self }
+    define_method(:instance_receiver) { self }
+  end
+  declare(:declaring_owner)
+end
+class ChildSelfCaptureRegistry < SelfCaptureRegistry
+end
+"#;
+const PROBE: &str = r#"
+raise "declaring self was not captured" unless SelfCaptureRegistry.declaring_owner.equal?(SelfCaptureRegistry)
+raise "inherited method rebound captured self" unless ChildSelfCaptureRegistry.declaring_owner.equal?(SelfCaptureRegistry)
+raise "method self did not follow subclass" unless ChildSelfCaptureRegistry.runtime_receiver.equal?(ChildSelfCaptureRegistry)
+instance = SelfCaptureRegistry.new
+raise "instance self became a class object" unless instance.instance_receiver.equal?(instance)
+puts "declaration self capture PASS"
+"#;
+fn app() -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("lib/self_capture_registry.rb", SOURCE)
+}
+#[test]
+fn declaring_class_capture_and_runtime_self_are_distinct() {
+    let original = emit_and_run::ruby().args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("{SOURCE}\n{PROBE}")).output().expect("run original class self capture");
+    assert!(original.status.success(), "{}", String::from_utf8_lossy(&original.stderr));
+    let (emitted, errors) = app().emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:#?}");
+    let lowered = emit_and_run::ruby().args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("require_relative 'app/models/self_capture_registry'\nrequire_relative 'app/models/child_self_capture_registry'\n{PROBE}"))
+        .current_dir(&*emitted).output().expect("run lowered class self capture");
+    assert!(lowered.status.success(), "{}", String::from_utf8_lossy(&lowered.stderr));
+    assert_eq!(original.stdout, lowered.stdout);
+}
+#[test]
+fn a_constant_added_observer_cannot_be_bypassed_by_self_capture_staging() {
+    let source = SOURCE.replace("  def self.declare(name)", "  def self.const_added(name); raise \"must not add synthetic observable constants\"; end\n  def self.declare(name)");
+    let (_, errors) = emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("lib/self_capture_registry.rb", &source)
+        .emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(!errors.is_empty(), "constant lifecycle observer was bypassed");
+}
+#[test]
+#[ignore = "requires Spinel; no external services"]
+fn declaring_self_capture_runs_natively_with_emitted_rbs() {
+    let run = app().run_spinel_with_rbs(PROBE);
+    run.assert_passes();
+    assert_eq!(run.stdout, "declaration self capture PASS\n");
+}
diff --git a/tests/entry_routes.rs b/tests/entry_routes.rs
new file mode 100644
index 000000000..e928747e0
--- /dev/null
+++ b/tests/entry_routes.rs
@@ -0,0 +1,329 @@
+//! Route-scoped Spinel emit keeps only the request closure of the selected
+//! flattened route patterns. These exercise the synthetic analyzed-App API,
+//! not hand-edited emitted Ruby.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use roundhouse::build_target::BuildTarget;
+use roundhouse::ingest::ingest_app_from_tree;
+
+fn tree(files: &[(&str, &str)]) -> HashMap<PathBuf, Vec<u8>> {
+    files
+        .iter()
+        .map(|(path, source)| (PathBuf::from(path), source.as_bytes().to_vec()))
+        .collect()
+}
+
+fn analyzed(files: &[(&str, &str)]) -> roundhouse::App {
+    let mut app = ingest_app_from_tree(tree(files)).expect("ingest synthetic app");
+    roundhouse::session::analyze_and_lower_for(&mut app, BuildTarget::Spinel);
+    app
+}
+
+fn select(app: &mut roundhouse::App, patterns: &[&str]) {
+    roundhouse::entry_routes::select(
+        app,
+        patterns.iter().map(|path| (*path).to_string()).collect(),
+    )
+    .expect("select requested entry routes");
+}
+
+fn class_names(app: &roundhouse::App) -> Vec<&str> {
+    app.entry_slice
+        .as_ref()
+        .expect("entry slice metadata")
+        .classes
+        .iter()
+        .map(String::as_str)
+        .collect()
+}
+
+const REQUEST_TREE: &[(&str, &str)] = &[
+    (
+        "db/schema.rb",
+        "ActiveRecord::Schema.define do\n  create_table :topics do |t|\n    t.string :title\n  end\n  create_table :unused_items do |t|\n    t.string :name\n  end\nend\n",
+    ),
+    (
+        "app/controllers/application_controller.rb",
+        "class ApplicationController < ActionController::Base\n  before_action :authenticate\n\n  private\n\n  def authenticate\n    AuthSupport.allowed?\n  end\nend\n",
+    ),
+    (
+        "app/controllers/topics_controller.rb",
+        "class TopicsController < ApplicationController\n  def show\n    @topic = Topic.find(params[:topic_id])\n    @title = TopicPresenter.title(@topic)\n    head :ok\n  end\n\n  def index\n    head :ok\n  end\n\n  private\n\n  def unused_helper\n    UnusedItem.first\n  end\nend\n",
+    ),
+    (
+        "app/controllers/unrelated_controller.rb",
+        "class UnrelatedController < ApplicationController\n  def index\n    UnusedItem.first\n  end\nend\n",
+    ),
+    (
+        "app/models/topic.rb",
+        "class Topic < ApplicationRecord\nend\n",
+    ),
+    (
+        "app/models/unused_item.rb",
+        "class UnusedItem < ApplicationRecord\nend\n",
+    ),
+    (
+        "app/models/auth_support.rb",
+        "module AuthSupport\n  def self.allowed?\n    true\n  end\nend\n",
+    ),
+    (
+        "app/models/topic_presenter.rb",
+        "module TopicPresenter\n  def self.title(topic)\n    topic.title\n  end\nend\n",
+    ),
+    (
+        "app/models/unused_support.rb",
+        "module UnusedSupport\n  def self.unused\n    true\n  end\nend\n",
+    ),
+    (
+        "test/controllers/topics_controller_test.rb",
+        r#"class TopicsControllerTest < ActiveSupport::TestCase
+  test "a placeholder" do
+    assert true
+  end
+end
+"#,
+    ),
+    ("test/fixtures/topics.yml", "one: {}\n"),
+    ("app/assets/stylesheets/unrelated.css", "body {}\n"),
+    ("public/unrelated.js", "window.unused = true;\n"),
+    (
+        "config/routes.rb",
+        "Rails.application.routes.draw do\n  get \"/t/:slug/:topic_id\", to: \"topics#show\"\n  get \"/unrelated\", to: \"unrelated#index\"\nend\n",
+    ),
+];
+
+#[test]
+fn selected_action_keeps_applicable_inherited_filter_and_transitive_helpers() {
+    let mut app = analyzed(REQUEST_TREE);
+    select(&mut app, &["/t/:slug/:topic_id"]);
+
+    let names = class_names(&app);
+    for reached in [
+        "ApplicationController",
+        "TopicsController",
+        "Topic",
+        "AuthSupport",
+        "TopicPresenter",
+    ] {
+        assert!(
+            names.contains(&reached),
+            "reachable class {reached} missing: {names:?}"
+        );
+    }
+    for dropped in ["UnrelatedController", "UnusedItem", "UnusedSupport"] {
+        assert!(
+            !names.contains(&dropped),
+            "unreachable class {dropped} retained: {names:?}"
+        );
+    }
+    assert_eq!(
+        app.controllers
+            .iter()
+            .map(|c| c.name.0.as_str())
+            .collect::<Vec<_>>(),
+        ["ApplicationController", "TopicsController",]
+    );
+    assert!(app.models.iter().any(|m| m.name.0.as_str() == "Topic"));
+    assert!(!app.models.iter().any(|m| m.name.0.as_str() == "UnusedItem"));
+
+    let topic_controller = app
+        .controllers
+        .iter()
+        .find(|c| c.name.0.as_str() == "TopicsController")
+        .unwrap();
+    let action_names: Vec<_> = topic_controller
+        .actions()
+        .map(|a| a.name.as_str())
+        .collect();
+    assert_eq!(action_names, ["show"]);
+    let slice = app.entry_slice.as_ref().unwrap();
+    for (owner, class_side, method) in [
+        ("ApplicationController", false, "authenticate"),
+        ("TopicsController", false, "show"),
+        ("TopicsController", false, "process_action"),
+        ("AuthSupport", true, "allowed?"),
+        ("TopicPresenter", true, "title"),
+    ] {
+        assert!(
+            slice.method(owner, class_side, method),
+            "missing {owner}#{method}"
+        );
+    }
+    assert!(!slice.method("TopicsController", false, "index"));
+    assert!(!slice.method("TopicsController", false, "unused_helper"));
+
+    // The route-sliced project does not carry unrelated test/assets trees.
+    let files = roundhouse::project::target_files(
+        &app,
+        Path::new("fixtures/tiny-api"),
+        BuildTarget::Spinel,
+    )
+    .expect("emit selected Spinel project");
+    let paths: Vec<_> = files.iter().map(|(path, _)| path.as_str()).collect();
+    assert!(
+        !paths.iter().any(|path| path.starts_with("test/")),
+        "test files retained: {paths:?}"
+    );
+    assert!(
+        !paths.iter().any(|path| path.starts_with("public/")),
+        "public assets retained: {paths:?}"
+    );
+    assert!(
+        !paths
+            .iter()
+            .any(|path| path.ends_with("unrelated_controller.rb")),
+        "unreachable controller emitted: {paths:?}"
+    );
+}
+
+#[test]
+fn optional_nested_patterns_are_literal_and_keep_all_verbs_for_each_match() {
+    let mut app = analyzed(&[
+        (
+            "app/controllers/topics_controller.rb",
+            "class TopicsController < ActionController::Base\n  def show\n    head :ok\n  end\nend\n",
+        ),
+        (
+            "config/routes.rb",
+            "Rails.application.routes.draw do\n  get \"/t/:slug/:topic_id(/:revision)\", to: \"topics#show\"\n  post \"/t/:slug/:topic_id(/:revision)\", to: \"topics#show\"\n  resources :topics, only: :show do\n    resources :posts, only: :show\n  end\n  get \"/t/:topic_id\", to: \"topics#show\"\nend\n",
+        ),
+    ]);
+
+    let before = roundhouse::lower::routes::flatten_routes(&app);
+    let optional: Vec<_> = before
+        .iter()
+        .filter(|route| route.source_path == "/t/:slug/:topic_id(/:revision)")
+        .map(|route| route.path.as_str())
+        .collect();
+    assert!(optional.contains(&"/t/:slug/:topic_id"));
+    assert!(optional.contains(&"/t/:slug/:topic_id/:revision"));
+    assert!(
+        before
+            .iter()
+            .any(|route| route.path == "/topics/:topic_id/posts/:id"),
+        "nested route not flattened: {before:?}"
+    );
+
+    select(
+        &mut app,
+        &["/t/:slug/:topic_id", "/t/:slug/:topic_id/:revision"],
+    );
+    let selected = roundhouse::lower::routes::flatten_routes(&app);
+    assert!(
+        selected
+            .iter()
+            .all(|route| route.path.starts_with("/t/:slug/:topic_id")),
+        "nonmatching route retained: {selected:?}"
+    );
+    assert_eq!(
+        selected
+            .iter()
+            .filter(|route| route.path == "/t/:slug/:topic_id")
+            .count(),
+        2,
+        "both verbs for an exact path must remain: {selected:?}"
+    );
+    assert!(selected
+        .iter()
+        .any(|route| route.path == "/t/:slug/:topic_id/:revision"));
+    assert!(!selected
+        .iter()
+        .any(|route| route.path == "/topics/:topic_id/posts/:id"));
+    assert!(
+        !selected.iter().any(|route| route.path == "/t/:topic_id"),
+        "parameter names are literal, not interchangeable: {selected:?}"
+    );
+}
+
+#[test]
+fn constant_only_reference_keeps_its_declaring_class() {
+    let mut app = analyzed(&[
+        (
+            "app/controllers/topics_controller.rb",
+            "class TopicsController < ActionController::Base\n  def show\n    @title = TopicSettings::DEFAULT_TITLE\n    head :ok\n  end\nend\n",
+        ),
+        (
+            "app/models/topic_settings.rb",
+            "module TopicSettings\n  DEFAULT_TITLE = \"Topics\"\nend\n",
+        ),
+        (
+            "app/models/unused_settings.rb",
+            "module UnusedSettings\n  VALUE = \"unused\"\nend\n",
+        ),
+        (
+            "config/routes.rb",
+            "Rails.application.routes.draw do\n  get \"/t/:topic_id\", to: \"topics#show\"\nend\n",
+        ),
+    ]);
+
+    select(&mut app, &["/t/:topic_id"]);
+    let names = class_names(&app);
+    assert!(
+        names.contains(&"TopicSettings"),
+        "constant-only dependency was dropped: {names:?}"
+    );
+    assert!(
+        !names.contains(&"UnusedSettings"),
+        "unreferenced constant owner retained: {names:?}"
+    );
+}
+
+#[test]
+fn patterns_without_an_ingested_route_are_reported_not_synthesized() {
+    let mut app = analyzed(REQUEST_TREE);
+    select(&mut app, &["/t/:slug/:topic_id", "/missing/:id"]);
+    let slice = app.entry_slice.as_ref().unwrap();
+    assert_eq!(slice.unmatched, ["/missing/:id"]);
+    assert!(roundhouse::lower::routes::flatten_routes(&app)
+        .iter()
+        .all(|route| route.path == "/t/:slug/:topic_id"));
+}
+
+#[test]
+fn selecting_only_unmatched_routes_is_an_error() {
+    let mut app = analyzed(REQUEST_TREE);
+    let error = roundhouse::entry_routes::select(&mut app, vec!["/missing/:id".into()])
+        .expect_err("must not invent a dispatch route");
+    assert!(error.contains("matched no ingested route"), "{error}");
+}
+
+#[test]
+fn tests_fixtures_and_web_assets_are_not_entry_roots() {
+    let mut app = analyzed(&[
+        (
+            "app/controllers/topics_controller.rb",
+            "class TopicsController < ActionController::Base\n  def show\n    head :ok\n  end\nend\n",
+        ),
+        (
+            "config/routes.rb",
+            "Rails.application.routes.draw do\n  get \"/t/:topic_id\", to: \"topics#show\"\nend\n",
+        ),
+        (
+            "test/controllers/unrelated_test.rb",
+            "class UnrelatedTest < ActionController::TestCase\nend\n",
+        ),
+        ("test/fixtures/topics.yml", "one: {}\n"),
+        ("app/assets/stylesheets/unrelated.css", "body {}\n"),
+        ("public/unrelated.js", "window.unused = true;\n"),
+    ]);
+    assert!(
+        !app.test_modules.is_empty(),
+        "fixture test should ingest before slicing"
+    );
+    assert!(
+        !app.fixtures.is_empty(),
+        "YAML fixture should ingest before slicing"
+    );
+    assert!(
+        app.stylesheets.iter().any(|name| name == "unrelated"),
+        "stylesheet should ingest before slicing: {:?}",
+        app.stylesheets
+    );
+    select(&mut app, &["/t/:topic_id"]);
+    assert!(app.test_modules.is_empty());
+    assert!(app.fixtures.is_empty());
+    assert!(app.binary_assets.is_empty());
+    assert!(app.stylesheets.is_empty());
+}
diff --git a/tests/entry_routes_cli.rs b/tests/entry_routes_cli.rs
new file mode 100644
index 000000000..53f3b8747
--- /dev/null
+++ b/tests/entry_routes_cli.rs
@@ -0,0 +1,245 @@
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+const MANIFEST_DIR: &str = env!("CARGO_MANIFEST_DIR");
+const ROUTES: &str = "Rails.application.routes.draw do\n\
+  get \"/posts\", to: \"posts#index\"\n\
+  post \"/posts\", to: \"posts#create\"\n\
+  get \"/posts/:id\", to: \"posts#show\"\n\
+  delete \"/posts/:id\", to: \"posts#destroy\"\n\
+  get \"/posts/archive\", to: \"posts#archive\"\n\
+end\n";
+const POSTS_CONTROLLER: &str = "class PostsController < ApplicationController\n\
+  def index; end\n\
+  def create; end\n\
+  def show; end\n\
+  def destroy; end\n\
+  def archive; end\n\
+end\n";
+
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new(label: &str) -> Self {
+        let unique = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let path = Path::new(MANIFEST_DIR).join("target").join(format!(
+            "entry-routes-cli-{label}-{}-{unique}",
+            std::process::id()
+        ));
+        fs::create_dir_all(&path).expect("create test scratch under target/");
+        Self(path)
+    }
+
+    fn app(&self) -> PathBuf {
+        self.0.join("source")
+    }
+
+    fn output(&self, name: &str) -> PathBuf {
+        self.0.join(name)
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+fn copy_tree(from: &Path, to: &Path) {
+    fs::create_dir_all(to).expect("create fixture directory");
+    for entry in fs::read_dir(from).expect("read fixture directory") {
+        let entry = entry.expect("fixture entry");
+        let dest = to.join(entry.file_name());
+        if entry.file_type().expect("fixture file type").is_dir() {
+            copy_tree(&entry.path(), &dest);
+        } else {
+            fs::copy(entry.path(), dest).expect("copy fixture file");
+        }
+    }
+}
+
+fn app(label: &str) -> Scratch {
+    let scratch = Scratch::new(label);
+    let root = scratch.app();
+    copy_tree(&Path::new(MANIFEST_DIR).join("fixtures/tiny-blog"), &root);
+    fs::write(root.join("config/routes.rb"), ROUTES).expect("write route fixture");
+    fs::write(
+        root.join("app/controllers/posts_controller.rb"),
+        POSTS_CONTROLLER,
+    )
+    .expect("write controller fixture");
+    scratch
+}
+
+fn run(args: &[&str], root: &Path, output: &Path) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_roundhouse"))
+        .args(args)
+        .arg(root)
+        .arg("-o")
+        .arg(output)
+        .output()
+        .expect("spawn roundhouse")
+}
+
+fn stderr(output: &Output) -> String {
+    String::from_utf8_lossy(&output.stderr).into_owned()
+}
+
+fn route_rows(output: &str) -> Vec<&str> {
+    output
+        .split("ActionDispatch::Router::Route.new(")
+        .skip(1)
+        .map(|args| args.split(')').next().expect("route constructor arguments"))
+        .collect()
+}
+
+fn emit_with_routes(args: &[&str], root: &Path, output: &Path) -> Vec<String> {
+    let result = run(args, root, output);
+    assert!(result.status.success(), "{}", stderr(&result));
+    let routes = fs::read_to_string(output.join("config/routes.rb")).expect("emitted RouteTable");
+    route_rows(&routes).into_iter().map(str::to_owned).collect()
+}
+
+#[test]
+fn separated_and_equals_entry_route_lists_are_accepted_and_filter_routes_and_actions() {
+    let scratch = app("syntax");
+    let separated = emit_with_routes(
+        &[
+            "--target",
+            "spinel",
+            "--allow-unsupported",
+            "--entry-routes",
+            "/posts,/posts/:id",
+        ],
+        &scratch.app(),
+        &scratch.output("separated"),
+    );
+    assert_eq!(separated.len(), 4, "{separated:#?}");
+    assert!(separated
+        .iter()
+        .any(|row| row.contains("\"/posts\"") && row.contains(":index")));
+    assert!(separated
+        .iter()
+        .any(|row| row.contains("\"/posts\"") && row.contains(":create")));
+    assert!(separated
+        .iter()
+        .any(|row| row.contains("\"/posts/:id\"") && row.contains(":show")));
+    assert!(separated
+        .iter()
+        .any(|row| row.contains("\"/posts/:id\"") && row.contains(":destroy")));
+    assert!(separated.iter().all(|row| !row.contains("archive")));
+    let controllers = fs::read_to_string(
+        scratch
+            .output("separated")
+            .join("app/controllers/posts_controller.rb"),
+    )
+    .expect("emitted selected controller");
+    assert!(controllers.contains("def index"), "{controllers}");
+    assert!(controllers.contains("def show"), "{controllers}");
+    assert!(!controllers.contains("def archive"), "{controllers}");
+
+    let equals = emit_with_routes(
+        &[
+            "--target=spinel",
+            "--allow-unsupported",
+            "--entry-routes=/posts,/posts/:id",
+        ],
+        &scratch.app(),
+        &scratch.output("equals"),
+    );
+    assert_eq!(equals, separated);
+}
+
+#[test]
+fn no_entry_route_flag_keeps_all_route_rows_and_actions() {
+    let scratch = app("default");
+    let rows = emit_with_routes(
+        &["--target", "spinel", "--allow-unsupported"],
+        &scratch.app(),
+        &scratch.output("all"),
+    );
+    assert_eq!(rows.len(), 5, "{rows:#?}");
+    assert!(rows
+        .iter()
+        .any(|row| row.contains("\"/posts/archive\"") && row.contains(":archive")));
+    let controllers = fs::read_to_string(
+        scratch
+            .output("all")
+            .join("app/controllers/posts_controller.rb"),
+    )
+    .expect("emitted controller");
+    assert!(controllers.contains("def archive"), "{controllers}");
+}
+
+#[test]
+fn empty_and_malformed_entry_route_lists_are_rejected() {
+    for value in [
+        "",
+        "posts",
+        "/posts,,/posts/:id",
+        "/posts?sort=recent",
+        "/posts(.:format)",
+    ] {
+        let result = Command::new(env!("CARGO_BIN_EXE_roundhouse"))
+            .args(["--target", "spinel", "--entry-routes", value])
+            .output()
+            .expect("spawn roundhouse");
+        assert!(!result.status.success(), "accepted {value:?}");
+        assert!(
+            stderr(&result).contains("--entry-routes"),
+            "{}",
+            stderr(&result)
+        );
+    }
+
+    let missing = Command::new(env!("CARGO_BIN_EXE_roundhouse"))
+        .args(["--target", "spinel", "--entry-routes"])
+        .output()
+        .expect("spawn roundhouse");
+    assert!(!missing.status.success());
+    assert!(
+        stderr(&missing).contains("--entry-routes requires"),
+        "{}",
+        stderr(&missing)
+    );
+}
+
+#[test]
+fn entry_routes_are_restricted_to_spinel_transpiles() {
+    for args in [
+        vec!["--target", "go", "--entry-routes=/posts"],
+        vec!["--site", "--entry-routes=/posts"],
+        vec!["--target", "fractal", "--entry-routes=/posts"],
+    ] {
+        let result = Command::new(env!("CARGO_BIN_EXE_roundhouse"))
+            .args(&args)
+            .output()
+            .expect("spawn roundhouse");
+        assert!(!result.status.success(), "accepted {args:?}");
+        assert!(
+            stderr(&result).contains("--entry-routes"),
+            "{}",
+            stderr(&result)
+        );
+    }
+}
+
+#[test]
+fn only_explicit_survey_slices_select_conservative_class_flow() {
+    let scratch = app("class-flow");
+    for (name, args, unified) in [
+        ("slice", vec!["--target", "spinel", "--allow-unsupported", "--entry-routes=/posts"], false),
+        ("survey-slice", vec!["--target", "spinel", "--survey", "--allow-unsupported", "--entry-routes=/posts"], true),
+        ("survey-whole", vec!["--target", "spinel", "--survey", "--allow-unsupported"], false),
+    ] {
+        let result = run(&args, &scratch.app(), &scratch.output(name));
+        assert!(result.status.success(), "{}", stderr(&result));
+        let manifest = fs::read_to_string(scratch.output(name).join("spin.toml")).expect("manifest");
+        assert_eq!(manifest.contains("class_flow = \"unified\""), unified, "{name}: {manifest}");
+    }
+}
diff --git a/tests/extended_declaration_macros.rs b/tests/extended_declaration_macros.rs
new file mode 100644
index 000000000..98e807ff5
--- /dev/null
+++ b/tests/extended_declaration_macros.rs
@@ -0,0 +1,90 @@
+//! Source-backed app-module `extend` declarations, without settings boot,
+//! cache writes, mutable service state or a production getter substitute.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const SOURCE: &str = r#"module DeclarationMethods
+  def declare(name, value)
+    clean_name = name.to_s.sub("?", "").to_sym
+    define_singleton_method clean_name do |scoped_to = nil|
+      value
+    end
+  end
+end
+class ExtendedValues
+  extend DeclarationMethods
+  declare :disabled?, false
+  declare "enabled?", true
+end
+"#;
+
+fn app(source: &str) -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("lib/extended_values.rb", source)
+}
+
+const PROBE: &str = r#"
+raise "false capture" unless ExtendedValues.disabled == false
+raise "optional argument" unless ExtendedValues.disabled(:scope) == false
+raise "true capture" unless ExtendedValues.enabled == true
+puts "extended declaration values PASS"
+"#;
+
+#[test]
+fn extended_declarations_run_on_emitted_ruby() {
+    let run = app(SOURCE).run_ruby(PROBE);
+    run.assert_passes();
+    assert_eq!(run.stdout, "extended declaration values PASS\n");
+}
+
+#[test]
+fn extension_effects_order_and_other_uses_remain_refused() {
+    let before_extend = SOURCE.replace(
+        "  extend DeclarationMethods\n  declare :disabled?, false",
+        "  declare :disabled?, false\n  extend DeclarationMethods",
+    );
+    let hook = SOURCE.replace("module DeclarationMethods\n", "module DeclarationMethods\n  def self.extended(base)\n    raise \"must not discard extension hook\"\n  end\n");
+    let constant = SOURCE.replace("module DeclarationMethods\n", "module DeclarationMethods\n  TAG = \"source scope\"\n");
+    let another_use = SOURCE.replace("class ExtendedValues\n", "class ExtendedValues\n  def self.declaration_module\n    DeclarationMethods\n  end\n");
+    let two_extenders = format!("{SOURCE}\nclass OtherValues\n  extend DeclarationMethods\nend\n");
+    let reopened = format!("{SOURCE}\nclass ExtendedValues\nend\n");
+    let initial_state = SOURCE.replace("module DeclarationMethods\n", "module DeclarationMethods\n  @before = true\n");
+    let class_hook = SOURCE.replace("class ExtendedValues\n", "class ExtendedValues\n  def self.singleton_method_added(name)\n    raise \"source callback must not be omitted\"\n  end\n");
+    let unrelated_load_call = SOURCE.replace("class ExtendedValues\n", "class ExtendedValues\n  def self.observe\n    respond_to?(:disabled)\n  end\n  observe\n");
+    let core_reopen = format!("class Class\nend\n{SOURCE}");
+    for source in [before_extend, hook, constant, another_use, two_extenders, reopened, initial_state, class_hook, unrelated_load_call, core_reopen] {
+        let (_tree, errors) = app(&source).emit(roundhouse::project::BuildTarget::Spinel);
+        assert!(errors.iter().any(|error| error.contains("runtime-defined method not supported") || error.contains("module is not extended until after this call")), "{errors:#?}");
+    }
+}
+
+#[test]
+fn class_load_observations_keep_original_declaration_order() {
+    let source = SOURCE.replace("class ExtendedValues\n", "class ExtendedValues\n  @reader_existed = respond_to?(:disabled)\n  def self.reader_existed\n    @reader_existed\n  end\n");
+    let run = app(&source).run_ruby("raise \"reader moved before declaration\" unless ExtendedValues.reader_existed == false\n");
+    run.assert_passes();
+    let (_tree, errors) = app(&source).emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.iter().any(|e| e.contains("runtime-defined method not supported")), "{errors:#?}");
+}
+
+#[test]
+fn mutable_and_runtime_extension_captures_are_not_relocated() {
+    for value in ["[]", "\"mutable\"", "\"runtime\".dup"] {
+        let source = SOURCE.replace("declare :disabled?, false", &format!("declare :disabled?, {value}"));
+        let (_tree, errors) = app(&source).emit(roundhouse::project::BuildTarget::Spinel);
+        assert!(errors.iter().any(|e| e.contains("captures a mutable or runtime value")), "{errors:#?}");
+    }
+    let unused_runtime = SOURCE.replace("    clean_name =", "    unused = helper\n    clean_name =")
+        .replace("module DeclarationMethods\n", "module DeclarationMethods\n  def helper\n    @runtime_value\n  end\n");
+    let (_tree, errors) = app(&unused_runtime).emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.iter().any(|e| e.contains("runtime evaluation before its extension is installed")), "{errors:#?}");
+}
+
+#[test]
+#[ignore = "requires Spinel; no external services"]
+fn extended_declarations_run_natively() {
+    let run = app(SOURCE).run_spinel_with_rbs(PROBE);
+    run.assert_passes();
+    assert_eq!(run.stdout, "extended declaration values PASS\n");
+}
diff --git a/tests/extension_lifecycle_runtime.rs b/tests/extension_lifecycle_runtime.rs
new file mode 100644
index 000000000..cdf9cb873
--- /dev/null
+++ b/tests/extension_lifecycle_runtime.rs
@@ -0,0 +1,225 @@
+//! Source-defined extension lifecycle callbacks receive the real receiver and
+//! extension module at the extend event, before the next class-body statement.
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+const SOURCE: &str = r#"module ExtensionLifecycle
+  def self.extended(receiver)
+    receiver.send(:note_extension, self)
+  end
+end
+
+class ExtensionLifecycleRoot
+  @events = [:body_start]
+
+  def self.note_extension(extension)
+    @events << extension.name.to_sym
+    @received = extension
+  end
+  private_class_method :note_extension
+
+  extend ExtensionLifecycle
+  @observed_after_extend = @events.dup
+
+  def self.report
+    [@events, @observed_after_extend, @received, self]
+  end
+end
+
+module ExtensionLifecycleTarget
+  @events = [:body_start]
+
+  def self.note_extension(extension)
+    @events << extension.name.to_sym
+    @received = extension
+  end
+  private_class_method :note_extension
+
+  extend ExtensionLifecycle
+  @observed_after_extend = @events.dup
+
+  def self.report
+    [@events, @observed_after_extend, @received, self]
+  end
+end
+"#;
+
+const PROBE: &str = r#"
+root_events, root_after, root_received, root_receiver = ExtensionLifecycleRoot.report
+raise "root callback count/order" unless root_events == [:body_start, :ExtensionLifecycle]
+raise "root class body did not observe callback" unless root_after == [:body_start, :ExtensionLifecycle]
+raise "callback self was not the source module" unless root_received.equal?(ExtensionLifecycle)
+raise "callback receiver was not the root class" unless root_receiver.equal?(ExtensionLifecycleRoot)
+
+module_events, module_after, module_received, module_receiver = ExtensionLifecycleTarget.report
+raise "module callback count/order" unless module_events == [:body_start, :ExtensionLifecycle]
+raise "module body did not observe callback" unless module_after == [:body_start, :ExtensionLifecycle]
+raise "module callback self was not the source module" unless module_received.equal?(ExtensionLifecycle)
+raise "callback receiver was not the target module" unless module_receiver.equal?(ExtensionLifecycleTarget)
+puts "extension lifecycle identity and order PASS"
+"#;
+
+fn app(source: &str) -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("lib/extension_lifecycle_runtime.rb", source)
+}
+
+fn original_ruby(source: &str, probe: &str) -> std::process::Output {
+    emit_and_run::ruby()
+        .args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("{source}\n{probe}"))
+        .output()
+        .expect("run original CRuby extension lifecycle control")
+}
+
+fn emitted_ruby(source: &str, probe: &str) -> std::process::Output {
+    let (emitted, errors) = app(source).emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:#?}");
+    emit_and_run::ruby()
+        .args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("require_relative 'app/models/extension_lifecycle_root'\nrequire_relative 'app/models/extension_lifecycle_target'\n{probe}"))
+        .current_dir(&*emitted)
+        .output()
+        .expect("run emitted Ruby extension lifecycle control")
+}
+
+#[test]
+fn extension_callback_receives_real_receiver_once_before_next_body_statement() {
+    let original = original_ruby(SOURCE, PROBE);
+    assert!(original.status.success(), "{}", String::from_utf8_lossy(&original.stderr));
+    assert_eq!(String::from_utf8_lossy(&original.stdout), "extension lifecycle identity and order PASS\n");
+
+    let lowered = emitted_ruby(SOURCE, PROBE);
+    assert!(
+        lowered.status.success(),
+        "{}\n{}",
+        String::from_utf8_lossy(&lowered.stdout),
+        String::from_utf8_lossy(&lowered.stderr)
+    );
+    assert_eq!(String::from_utf8_lossy(&lowered.stdout), "extension lifecycle identity and order PASS\n");
+
+    // The callback, not a synthetic seed element, supplies an empty trace's
+    // element type. Both source controls must still observe the same hook.
+    let empty = SOURCE.replace("[:body_start]", "[]");
+    let empty_probe = PROBE.replace("[:body_start, :ExtensionLifecycle]", "[:ExtensionLifecycle]");
+    let original_empty = original_ruby(&empty, &empty_probe);
+    assert!(original_empty.status.success(), "{}", String::from_utf8_lossy(&original_empty.stderr));
+    let lowered_empty = emitted_ruby(&empty, &empty_probe);
+    assert!(lowered_empty.status.success(), "{}", String::from_utf8_lossy(&lowered_empty.stderr));
+    assert_eq!(original_empty.stdout, lowered_empty.stdout);
+}
+
+// Model host for the same lifecycle boundary. The actual-ActiveRecord original
+// reference is a separate owned experiment; this consumer loads no DB adapter.
+const MODEL_MODULE: &str = r#"module BootstrapExtension
+  def self.extended(klass)
+    klass.send(:note_bootstrap, :extended)
+  end
+  def bootstrap_events
+    @bootstrap_events ||= []
+  end
+  protected
+  def note_bootstrap(event)
+    bootstrap_events << event
+  end
+end
+"#;
+const MODEL: &str = r#"class BootstrapSetting < ActiveRecord::Base
+  extend BootstrapExtension
+  @observed = bootstrap_events.dup
+  def self.observed
+    @observed
+  end
+end
+"#;
+const MODEL_PROBE: &str = r#"
+raise "model extension callback missing or wrong order" unless BootstrapSetting.observed == [:extended]
+raise "model callback ran again" unless BootstrapSetting.bootstrap_events == [:extended]
+puts "model extension bootstrap PASS"
+"#;
+
+fn model_app() -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write("config/routes.rb", "Rails.application.routes.draw do\nend\n")
+        .write("db/schema.rb", "ActiveRecord::Schema.define do\n  create_table :bootstrap_settings do |t|\n    t.string :name\n  end\nend\n")
+        .write("app/models/bootstrap_extension.rb", MODEL_MODULE)
+        .write("app/models/bootstrap_setting.rb", MODEL)
+}
+
+#[test]
+fn model_extension_installs_the_protected_method_before_its_real_hook() {
+    let (emitted, errors) = model_app().emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:#?}");
+    let lowered = emit_and_run::ruby().args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("require_relative 'app/models/bootstrap_setting'\n{MODEL_PROBE}"))
+        .current_dir(&*emitted).output().expect("run model extension lifecycle");
+    assert!(lowered.status.success(), "{}", String::from_utf8_lossy(&lowered.stderr));
+    assert_eq!(lowered.stdout, b"model extension bootstrap PASS\n");
+}
+
+const CHANGING_SOURCE: &str = r#"module TypeChangingExtension
+  def self.extended(receiver)
+    receiver.send(:note_extension, self)
+  end
+end
+class LifecycleTypeChange
+  @state = :before
+  def initialize
+    @state = 42
+  end
+  def self.note_extension(extension)
+    @state = nil
+  end
+  extend TypeChangingExtension
+  @seen = @state || :fallback
+  def self.report
+    @seen
+  end
+end
+"#;
+const CHANGING_PROBE: &str = r#"
+raise "callback nil write was folded using stale initializer" unless LifecycleTypeChange.report == :fallback
+puts "extension callback storage join PASS"
+"#;
+
+#[test]
+fn callback_writes_preserve_nil_and_exclude_instance_state_in_initializer_types() {
+    let original = original_ruby(CHANGING_SOURCE, CHANGING_PROBE);
+    assert!(original.status.success(), "{}", String::from_utf8_lossy(&original.stderr));
+    let (emitted, typed, errors) = app(CHANGING_SOURCE).emit_with_app(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{errors:#?}");
+    fn check(expr: &roundhouse::expr::Expr, reads: &mut usize) {
+        if matches!(&*expr.node, roundhouse::expr::ExprNode::Ivar { name } if name.as_str() == "state") {
+            *reads += 1;
+            let Some(roundhouse::ty::Ty::Union { variants }) = &expr.ty else { panic!("class storage lost nil: {:?}", expr.ty) };
+            assert!(variants.contains(&roundhouse::ty::Ty::Nil), "{variants:?}");
+            assert!(variants.contains(&roundhouse::ty::Ty::Sym), "{variants:?}");
+            assert!(!variants.contains(&roundhouse::ty::Ty::Int), "instance state leaked: {variants:?}");
+        }
+        expr.node.for_each_child(&mut |child| check(child, reads));
+    }
+    let class = typed.library_classes.iter().find(|class| class.name.0.as_str() == "LifecycleTypeChange").expect("typed class");
+    let mut reads = 0;
+    for initializer in &class.class_ivar_initializers { check(initializer, &mut reads); }
+    assert!(reads > 0, "missing initializer class-state read");
+    let lowered = emit_and_run::ruby().args(["--enable-frozen-string-literal", "-e"])
+        .arg(format!("require_relative 'app/models/lifecycle_type_change'\n{CHANGING_PROBE}"))
+        .current_dir(&*emitted).output().expect("run nil-changing callback control");
+    assert!(lowered.status.success(), "{}", String::from_utf8_lossy(&lowered.stderr));
+    assert_eq!(original.stdout, lowered.stdout);
+}
+
+#[test]
+#[ignore = "requires Spinel; no external services"]
+fn extension_lifecycle_runs_natively_with_emitted_rbs() {
+    let run = app(SOURCE).run_spinel_with_rbs(PROBE);
+    run.assert_passes();
+    assert_eq!(run.stdout, "extension lifecycle identity and order PASS\n");
+    let changed = app(CHANGING_SOURCE).run_spinel_with_rbs(CHANGING_PROBE);
+    changed.assert_passes();
+    assert_eq!(changed.stdout, "extension callback storage join PASS\n");
+    let model = model_app().run_spinel_with_rbs(MODEL_PROBE);
+    model.assert_passes();
+    assert_eq!(model.stdout, "model extension bootstrap PASS\n");
+}
diff --git a/tests/float_write_serialization.rs b/tests/float_write_serialization.rs
