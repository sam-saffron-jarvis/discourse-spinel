+    fn closed(expr: &roundhouse::expr::Expr) {
+        assert!(
+            expr.ty.as_ref().is_some_and(|ty| !ty.mentions_unknown()),
+            "{expr:#?}"
+        );
+        expr.node.for_each_child(&mut closed);
