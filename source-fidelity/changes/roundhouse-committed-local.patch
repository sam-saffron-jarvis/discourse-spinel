+fn rewrite(expr: &mut Expr, mutators: &HashSet<Symbol>) {
+    invalidate_key_evidence(expr, mutators);
+    fn walk(e: &mut Expr) {
+        e.node.for_each_child_mut(&mut walk);
+        rewrite_node(e);
+    }
+    walk(expr);
+}
+
+// Conservative by method name: an ambiguous receiver must not retain stale
+// key evidence. Include wrappers transitively, so a caller's aliases count too.
+pub(crate) fn key_mutators(app: &App) -> HashSet<Symbol> {
+    let methods: Vec<_> = crate::analyze::forwarding::methods(app)
+        .map(|(_, m)| (&m.name, &m.body))
+        .chain(app.controllers.iter().flat_map(|c| c.class_methods().map(|m| (&m.name, &m.body))))
+        .chain(app.controllers.iter().flat_map(|c| c.actions().map(|a| (&a.name, &a.body))))
+        .collect();
+    let mut mutators: HashSet<Symbol> = [Symbol::from("deep_symbolize_keys!")].into_iter().collect();
+    loop {
+        let before = mutators.len();
+        for (name, body) in &methods {
+            if calls_key_mutator(body, &mutators) { mutators.insert((*name).clone()); }
+        }
+        if mutators.len() == before { return mutators; }
+    }
+}
+
+fn calls_key_mutator(e: &Expr, mutators: &HashSet<Symbol>) -> bool {
+    if matches!(&*e.node, ExprNode::Send { method, .. } if mutators.contains(method)) { return true; }
