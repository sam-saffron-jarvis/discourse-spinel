+use crate::{App, ClassId};
+
+fn path(expr: &Expr) -> Option<ClassId> {
+    let ExprNode::Const { path } = &*expr.node else {
+        return None;
+    };
+    Some(crate::analyze::mixin_path_id(path))
+}
+fn extension(expr: &Expr) -> Option<ClassId> {
+    let ExprNode::Send {
+        recv: None,
+        method,
+        args,
+        block: None,
+        ..
+    } = &*expr.node
+    else {
+        return None;
+    };
+    if method.as_str() != "extend" {
+        return None;
+    }
+    let [module] = args.as_slice() else {
+        return None;
+    };
+    path(module)
+}
+fn walk(expr: &Expr, f: &mut impl FnMut(&Expr)) {
+    f(expr);
+    expr.node.for_each_child(&mut |child| walk(child, f));
+}
+
+pub(crate) fn prepare(app: &mut App) {
+    if !app.runtime_extension_events.is_empty() {
+        return;
+    }
+    let sole = app.sole_extender_of_modules();
+    let mut events = Vec::new();
+    for module in app.library_classes.iter().filter(|class| class.is_module) {
+        let Some(owner) = sole.get(&module.name) else {
+            continue;
+        };
+        let mut producer = false;
+        for method in module
+            .methods
+            .iter()
+            .filter(|method| method.receiver == MethodReceiver::Instance)
+        {
+            walk(&method.body, &mut |expr| {
+                producer |= matches!(&*expr.node, ExprNode::Send { recv: None, method, .. } if method.as_str() == "define_singleton_method");
+            });
+        }
+        if !producer {
+            continue;
+        }
+        let mut sites = Vec::new();
+        for class in app
+            .library_classes
+            .iter()
+            .filter(|class| &class.name == owner)
+        {
+            sites.extend(
+                class
+                    .unknown_calls
+                    .iter()
+                    .filter(|call| extension(call).as_ref() == Some(&module.name))
+                    .cloned(),
+            );
+        }
+        for model in app.models.iter().filter(|model| &model.name == owner) {
+            sites.extend(model.body.iter().filter_map(|item| match item {
+                ModelBodyItem::Unknown { expr, .. }
+                    if extension(expr).as_ref() == Some(&module.name) =>
+                {
+                    Some(expr.clone())
+                }
+                _ => None,
+            }));
+        }
+        // Repeated/dynamic extension and module-object escapes need a richer
+        // domain proof. A source class-method read does not mix its instance
+        // producers into another object and remains ordinary module dispatch.
+        let [site] = sites.as_slice() else { continue };
+        let mut safe = true;
+        fn uses(
+            expr: &Expr,
+            module: &ClassId,
+            site: &Expr,
+            class_methods: &[crate::Symbol],
+            safe: &mut bool,
+        ) {
+            if expr.span == site.span && expr.node == site.node {
+                return;
+            }
+            if let ExprNode::Send {
+                recv: Some(receiver),
+                method,
+                args,
+                block,
+                ..
+            } = &*expr.node
+                && path(receiver).as_ref() == Some(module)
+                && class_methods.contains(method)
+                && !matches!(method.as_str(), "extended" | "extend_object")
+            {
+                for arg in args {
+                    uses(arg, module, site, class_methods, safe);
+                }
+                if let Some(block) = block {
+                    uses(block, module, site, class_methods, safe);
+                }
+                return;
+            }
+            if path(expr).as_ref() == Some(module) {
+                *safe = false;
+                return;
+            }
+            expr.node
+                .for_each_child(&mut |child| uses(child, module, site, class_methods, safe));
+        }
+        let methods: Vec<_> = module
+            .methods
+            .iter()
+            .filter(|method| method.receiver == MethodReceiver::Class)
+            .map(|method| method.name.clone())
+            .collect();
+        crate::lower::for_each_emit_body_ref(app, &mut |expr| {
+            uses(expr, &module.name, site, &methods, &mut safe)
+        });
+        if safe {
+            events.push(RuntimeExtensionEvent {
+                module: module.name.clone(),
+                owner: owner.clone(),
+                original: site.clone(),
+            });
+        }
+    }
+    app.runtime_extension_events = events;
+}
+
+/// The source definition behind an owner's folded class-side surface. This is
+/// parameter evidence routing, not a copied MethodDef or a new dispatch table.
+/// Ambiguous competing modules remain uninferred; an owner's own def wins.
+pub(super) fn parameter_targets(
+    app: &App,
+) -> std::collections::BTreeMap<(ClassId, crate::Symbol), ClassId> {
+    let mut targets = std::collections::BTreeMap::new();
+    for event in &app.runtime_extension_events {
+        let Some(module) = app
+            .library_classes
+            .iter()
+            .find(|class| class.name == event.module)
+        else {
+            continue;
+        };
+        for method in module
+            .methods
+            .iter()
+            .filter(|method| method.receiver == MethodReceiver::Instance)
+        {
+            let own = app
+                .library_classes
+                .iter()
+                .filter(|class| class.name == event.owner)
+                .flat_map(|class| &class.methods)
+                .any(|candidate| {
+                    candidate.receiver == MethodReceiver::Class && candidate.name == method.name
+                })
+                || app
+                    .models
+                    .iter()
+                    .filter(|model| model.name == event.owner)
+                    .flat_map(|model| model.methods())
+                    .any(|candidate| {
+                        candidate.receiver == MethodReceiver::Class && candidate.name == method.name
+                    });
+            if own {
+                continue;
+            }
+            let calls = app
+                .library_classes
+                .iter()
+                .filter(|class| class.name == event.owner)
+                .flat_map(|class| class.unknown_calls.iter())
+                .chain(
+                    app.models
+                        .iter()
+                        .filter(|model| model.name == event.owner)
+                        .flat_map(|model| {
+                            model.body.iter().filter_map(|item| match item {
+                                ModelBodyItem::Unknown { expr, .. } => Some(expr),
+                                _ => None,
+                            })
+                        }),
+                );
+            let competing = calls.into_iter().any(|call| {
+                let ExprNode::Send {
+                    method: name,
+                    args,
+                    block,
+                    ..
+                } = &*call.node
+                else {
+                    return false;
+                };
+                if name.as_str() != "extend" {
+                    return false;
+                }
+                if block.is_some() {
+                    return true;
+                }
+                args.iter().any(|arg| {
+                    let Some(other) = path(arg) else { return true };
+                    other != event.module
+                        && app
+                            .library_classes
+                            .iter()
+                            .filter(|class| class.name == other)
+                            .any(|class| {
+                                !class.includes.is_empty()
+                                    || class.methods.iter().any(|candidate| {
+                                        candidate.receiver == MethodReceiver::Instance
+                                            && candidate.name == method.name
+                                    })
+                            })
+                })
+            });
+            if !competing {
+                targets.insert(
+                    (event.owner.clone(), method.name.clone()),
+                    event.module.clone(),
+                );
+            }
+        }
+    }
+    targets
+}
+
+/// Source writes through a proven memoized Hash reader belong to the same
+/// extender storage as direct ivar writes. Retain only types, never values.
+pub(super) fn collect_storage_fields(
+    app: &App,
+    fields: &mut crate::det::HashMap<ClassId, crate::det::HashMap<crate::Symbol, crate::ty::Ty>>,
+) {
+    use crate::expr::{LValue, OpAssignOp};
+    use crate::ty::Ty;
+    // A per-site reader returns one nested memoized Hash rather than its
+    // whole ivar. Recognize only the exact seed/index-seed shape; retain the
+    // source index TYPE, never its current runtime value or a default site.
+    fn empty_hash(expr: &Expr) -> bool {
+        matches!(&*expr.node, ExprNode::Hash { entries, .. } if entries.is_empty())
+    }
+    fn observed(expr: &Expr) -> Ty {
+        expr.ty.clone().filter(|ty| !ty.mentions_unknown()).unwrap_or(Ty::Untyped)
+    }
+    fn memoized_reader(body: &Expr) -> Option<(crate::Symbol, Vec<Ty>)> {
+        fn seed(expr: &Expr) -> Option<crate::Symbol> {
+            match &*expr.node {
+                ExprNode::OpAssign { target: LValue::Ivar { name }, op: OpAssignOp::OrOr, value }
+                    if empty_hash(value) => Some(name.clone()),
+                _ => None,
+            }
+        }
+        if let Some(name) = seed(body) { return Some((name, Vec::new())); }
+        let ExprNode::Seq { exprs } = &*body.node else { return None; };
+        let [outer, inner] = exprs.as_slice() else { return None; };
+        let name = seed(outer)?;
+        let ExprNode::OpAssign { target: LValue::Index { recv, index }, op: OpAssignOp::OrOr, value } = &*inner.node else { return None; };
+        if !empty_hash(value) || !matches!(&*recv.node, ExprNode::Ivar { name: field } if field == &name) { return None; }
+        Some((name, vec![observed(index)]))
+    }
+    let targets = parameter_targets(app);
+    for event in &app.runtime_extension_events {
+        let Some(module) = app
+            .library_classes
+            .iter()
+            .find(|class| class.name == event.module)
+        else {
+            continue;
+        };
+        let owner_fields = fields.entry(event.owner.clone()).or_default();
+        let mut readers = std::collections::BTreeMap::new();
+        for method in module
+            .methods
+            .iter()
+            .filter(|method| method.receiver == MethodReceiver::Instance)
+        {
+            if method.params.is_empty()
+                && method.block_param.is_none()
+                && targets.get(&(event.owner.clone(), method.name.clone())) == Some(&event.module)
+                && let Some((name, prefix)) = memoized_reader(&method.body)
+            {
+                // The empty seed has no elements to constrain: its previous
+                // inferred annotation is not another runtime writer. Rebuild
+                // from this round's real writes, including unresolved ones.
+                owner_fields
+                    .entry(name.clone())
+                    .or_insert_with(|| Ty::Hash {
+                        key: std::sync::Arc::new(Ty::Var {
+                            var: crate::ident::TyVar(0),
+                        }),
+                        value: std::sync::Arc::new(Ty::Var {
+                            var: crate::ident::TyVar(0),
+                        }),
+                    });
+                readers.insert(method.name.clone(), (name, prefix));
+            } else {
+                super::extract_ivar_assignments(&method.body, owner_fields);
+            }
+        }
+        fn owner_receiver(receiver: Option<&Expr>, owner: &ClassId, implicit: bool) -> bool {
+            match receiver.map(|receiver| &*receiver.node) {
+                None | Some(ExprNode::SelfRef) => implicit,
+                Some(ExprNode::Const { path: written }) => super::mixin_path_id(written) == *owner,
+                _ => receiver.is_some_and(|receiver| matches!(&receiver.ty, Some(Ty::Class { id, args })
+                    if id.0.as_str() == "Class" && matches!(args.as_slice(), [Ty::Class { id, .. }] if id == owner))),
+            }
+        }
+        let collect =
+            |body: &Expr,
+             implicit: bool,
+             owner_fields: &mut crate::det::HashMap<crate::Symbol, Ty>| {
+                walk(body, &mut |expr| {
+                    let (receiver, key, value) = match &*expr.node {
+                        ExprNode::Send {
+                            recv: Some(receiver),
+                            method,
+                            args,
+                            block: None,
+                            ..
+                        } if method.as_str() == "[]=" && args.len() == 2 => {
+                            (receiver, &args[0], &args[1])
+                        }
+                        ExprNode::Assign {
+                            target: LValue::Index { recv, index },
+                            value,
+                        } => (recv, index, value),
+                        _ => return,
+                    };
+                    // Keep all nested [] indices on the original alias path.
+                    // A different receiver or non-index operation is not this
+                    // reader's storage and contributes no inferred write.
+                    let mut receiver = receiver;
+                    let mut indices = vec![observed(key)];
+                    while let ExprNode::Send { recv: Some(parent), method, args, block: None, .. } = &*receiver.node {
+                        if method.as_str() != "[]" || args.len() != 1 { break; }
+                        indices.push(observed(&args[0]));
+                        receiver = parent;
+                    }
+                    let ExprNode::Send { recv, method, args, block: None, .. } = &*receiver.node else { return; };
+                    let Some((field, prefix)) = readers.get(method) else { return; };
+                    if !args.is_empty() || !owner_receiver(recv.as_ref(), &event.owner, implicit) { return; }
+                    indices.reverse();
+                    let mut keys = prefix.iter().cloned().chain(indices).collect::<Vec<_>>();
+                    // Unknown writers remain debt, even beside concrete writes.
+                    let mut incoming = observed(value);
+                    while keys.len() > 1 {
+                        incoming = Ty::Hash { key: std::sync::Arc::new(keys.pop().unwrap()), value: std::sync::Arc::new(incoming) };
+                    }
+                    super::widen_hash_ivar_value(owner_fields, field, keys.pop(), incoming);
+                });
+            };
+        for method in module
+            .methods
+            .iter()
+            .filter(|method| method.receiver == MethodReceiver::Instance)
+        {
+            collect(&method.body, true, owner_fields);
+        }
+        crate::lower::for_each_emit_body_ref(app, &mut |body| collect(body, false, owner_fields));
+        for class in app
+            .library_classes
+            .iter()
+            .filter(|class| class.name == event.owner)
+        {
+            for method in class
+                .methods
+                .iter()
+                .filter(|method| method.receiver == MethodReceiver::Class)
+            {
+                collect(&method.body, true, owner_fields);
+            }
+            for body in &class.unknown_calls {
+                collect(body, true, owner_fields);
+            }
+        }
+        for model in app.models.iter().filter(|model| model.name == event.owner) {
+            for method in model
+                .methods()
+                .filter(|method| method.receiver == MethodReceiver::Class)
+            {
+                collect(&method.body, true, owner_fields);
+            }
+        }
+    }
+}
diff --git a/src/analyze/singleton_storage.rs b/src/analyze/singleton_storage.rs
new file mode 100644
index 000000000..0428cb06e
--- /dev/null
+++ b/src/analyze/singleton_storage.rs
@@ -0,0 +1,271 @@
+//! Rebuild source singleton memoized Hash slots from actual writers. Empty
+//! literal annotations from a prior typing round are not stored-value evidence.
+use crate::det::HashMap;
+use crate::dialect::MethodReceiver;
+use crate::expr::{Expr, ExprNode, LValue, Literal, OpAssignOp};
+use crate::ty::Ty;
+use crate::{App, ClassId, Symbol};
+use std::collections::BTreeSet;
+use std::sync::Arc;
+
+fn pending_hash() -> Ty {
+    Ty::Hash {
+        key: Arc::new(Ty::Var {
+            var: crate::ident::TyVar(0),
+        }),
+        value: Arc::new(Ty::Var {
+            var: crate::ident::TyVar(0),
+        }),
+    }
+}
+fn same_receiver(receiver: Option<&Expr>) -> bool {
+    receiver.is_none_or(|receiver| matches!(&*receiver.node, ExprNode::SelfRef))
+}
+fn literal_field(expr: &Expr) -> Option<Symbol> {
+    let text = match &*expr.node {
+        ExprNode::Lit {
+            value: Literal::Sym { value },
+        } => value.as_str(),
+        ExprNode::Lit {
+            value: Literal::Str { value },
+        } => value,
+        _ => return None,
+    };
+    text.strip_prefix('@').map(Symbol::from)
+}
+
+pub(super) fn collect(app: &App, fields: &mut HashMap<ClassId, HashMap<Symbol, Ty>>) {
+    for class in app
+        .library_classes
+        .iter()
+        .filter(|class| class.origin.is_none())
+    {
+        if app
+            .library_classes
+            .iter()
+            .filter(|other| other.name == class.name)
+            .count()
+            != 1
+        {
+            continue;
+        }
+        let names: BTreeSet<_> = class.methods.iter().filter(|method| method.receiver == MethodReceiver::Class && method.params.is_empty() && method.block_param.is_none()
+            && !app.rbs_signatures.get(&class.name).is_some_and(|methods| methods.contains_key(&method.name)))
+            .filter_map(|method| match &*method.body.node {
+                ExprNode::OpAssign { target: LValue::Ivar { name }, op: OpAssignOp::OrOr, value }
+                    if matches!(&*value.node, ExprNode::Hash { entries, .. } if entries.is_empty()) => Some(name.clone()),
+                _ => None,
+            }).collect();
+        if names.is_empty() {
+            continue;
+        }
+        let mut fresh: HashMap<_, _> = names
+            .iter()
+            .map(|name| (name.clone(), pending_hash()))
+            .collect();
+        let mut opaque = BTreeSet::new();
+        fn value_write(
+            name: &Symbol,
+            value: &Expr,
+            fresh: &mut HashMap<Symbol, Ty>,
+            opaque: &mut BTreeSet<Symbol>,
+        ) {
+            if matches!(&*value.node, ExprNode::Hash { entries, .. } if entries.is_empty()) {
+                return;
+            }
+            let ty = value.ty.clone().unwrap_or(Ty::Untyped);
+            if !matches!(ty.peel_nilable(), Ty::Hash { .. } | Ty::Nil) {
+                opaque.insert(name.clone());
+                return;
+            }
+            let previous = fresh.remove(name).unwrap_or_else(pending_hash);
+            fresh.insert(name.clone(), super::body::join_ivar_slot(previous, ty));
+        }
+        fn visit(
+            expr: &Expr,
+            names: &BTreeSet<Symbol>,
+            fresh: &mut HashMap<Symbol, Ty>,
+            opaque: &mut BTreeSet<Symbol>,
+        ) {
+            if expr.nested_def().is_some() {
+                return;
+            }
+            // A field handed to another local/call/return can be mutated
+            // through that alias. Only direct indexed access and the known
+            // read-only receiver operations below are closed observations.
+            if let ExprNode::Ivar { name } = &*expr.node {
+                if names.contains(name) {
+                    opaque.insert(name.clone());
+                }
+                return;
+            }
+            match &*expr.node {
+                ExprNode::Assign {
+                    target: LValue::Ivar { name },
+                    value,
+                }
+                | ExprNode::OpAssign {
+                    target: LValue::Ivar { name },
+                    value,
+                    ..
+                } if names.contains(name) => value_write(name, value, fresh, opaque),
+                ExprNode::Send {
+                    recv, method, args, ..
+                } if same_receiver(recv.as_ref()) && method.as_str() == "instance_variable_set" => {
+                    if let [name, value] = args.as_slice() {
+                        if let Some(name) = literal_field(name) {
+                            if names.contains(&name) {
+                                value_write(&name, value, fresh, opaque);
+                            }
+                        } else {
+                            opaque.extend(names.iter().cloned());
+                        }
+                    } else {
+                        opaque.extend(names.iter().cloned());
+                    }
+                }
+                ExprNode::Send {
+                    recv, method, args, ..
+                } if same_receiver(recv.as_ref())
+                    && matches!(method.as_str(), "send" | "__send__" | "public_send") =>
+                {
+                    let target = args.first().and_then(|arg| match &*arg.node {
+                        ExprNode::Lit {
+                            value: Literal::Sym { value },
+                        } => Some(value.as_str()),
+                        ExprNode::Lit {
+                            value: Literal::Str { value },
+                        } => Some(value.as_str()),
+                        _ => None,
+                    });
+                    if target.is_none_or(|name| name == "instance_variable_set") {
+                        opaque.extend(names.iter().cloned());
+                    }
+                }
+                ExprNode::Send {
+                    method,
+                    block: Some(_),
+                    ..
+                } if matches!(
+                    method.as_str(),
+                    "instance_eval"
+                        | "instance_exec"
+                        | "class_eval"
+                        | "class_exec"
+                        | "module_eval"
+                        | "module_exec"
+                ) =>
+                {
+                    opaque.extend(names.iter().cloned());
+                    return;
+                }
+                _ => {}
+            }
+            if let ExprNode::Send {
+                recv: Some(receiver),
+                method,
+                ..
+            } = &*expr.node
+                && let ExprNode::Ivar { name } = &*receiver.node
+                && names.contains(name)
+                && !matches!(
+                    method.as_str(),
+                    "[]="
+                        | "[]"
+                        | "fetch"
+                        | "key?"
+                        | "has_key?"
+                        | "include?"
+                        | "size"
+                        | "length"
+                        | "empty?"
+                        | "keys"
+                        | "values"
+                        | "each"
+                        | "each_key"
+                        | "each_value"
+                        | "clear"
+                )
+            {
+                opaque.insert(name.clone());
+            }
+            let indexed = match &*expr.node {
+                ExprNode::Send {
+                    recv: Some(receiver),
+                    method,
+                    args,
+                    block: None,
+                    ..
+                } if method.as_str() == "[]=" && args.len() == 2 => {
+                    Some((receiver, &args[0], &args[1]))
+                }
+                ExprNode::Assign {
+                    target: LValue::Index { recv, index },
+                    value,
+                }
+                | ExprNode::OpAssign {
+                    target: LValue::Index { recv, index },
+                    value,
+                    ..
+                } => Some((recv, index, value)),
+                _ => None,
+            };
+            if let Some((receiver, key, value)) = indexed
+                && let ExprNode::Ivar { name } = &*receiver.node
+                && names.contains(name)
+            {
+                let observed = |expr: &Expr| {
+                    expr.ty
+                        .clone()
+                        .filter(|ty| !ty.mentions_unknown())
+                        .unwrap_or(Ty::Untyped)
+                };
+                super::widen_hash_ivar_value(fresh, name, Some(observed(key)), observed(value));
+            }
+            let receiver = match &*expr.node {
+                ExprNode::Send {
+                    recv: Some(receiver),
+                    ..
+                } => Some(receiver),
+                ExprNode::Assign {
+                    target: LValue::Index { recv, .. },
+                    ..
+                }
+                | ExprNode::OpAssign {
+                    target: LValue::Index { recv, .. },
+                    ..
+                } => Some(recv),
+                _ => None,
+            };
+            expr.node.for_each_child(&mut |child| {
+                if receiver.is_some_and(|receiver| std::ptr::eq(receiver, child))
+                    && matches!(&*child.node, ExprNode::Ivar { .. })
+                {
+                    return;
+                }
+                visit(child, names, fresh, opaque);
+            });
+        }
+        for body in class
+            .methods
+            .iter()
+            .filter(|method| method.receiver == MethodReceiver::Class)
+            .map(|method| &method.body)
+            .chain(class.class_ivar_initializers.iter())
+            .chain(class.unknown_calls.iter())
+        {
+            visit(body, &names, &mut fresh, &mut opaque);
+        }
+        let target = fields.entry(class.name.clone()).or_default();
+        for (name, value) in fresh {
+            target.insert(
+                name.clone(),
+                if opaque.contains(&name) {
+                    Ty::Untyped
+                } else {
+                    value
+                },
+            );
+        }
+    }
+}
