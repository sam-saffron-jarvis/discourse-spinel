+            assert_eq!(parsed.errors().count(), 0, "{source}");
+            let root = parsed.node();
+            let statement = root
+                .as_program_node()
+                .unwrap()
+                .statements()
+                .body()
+                .iter()
+                .next()
+                .unwrap();
+            let expr = roundhouse::ingest::ingest_expr(&statement, "<index-write>").unwrap();
