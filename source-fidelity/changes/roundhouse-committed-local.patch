+        fn visit_call_node(&mut self, call: &ruby_prism::CallNode<'pr>) {
+            let name = super::util::constant_id_str(&call.name());
+            let dsl = call.receiver().is_none_or(|recv| recv.as_self_node().is_some());
+            let kind = if dsl { "DSL" } else { "boot call" };
+            let message = format!("plugin.rb {kind} not modeled: {name}");
+            if self.seen.insert(message.clone()) {
