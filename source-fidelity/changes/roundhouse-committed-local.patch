+/// Only direct definitions are executed by the new literal callback route.
+/// Method bodies are deferred, not walked as declaration-time effects.
+fn declaration_callback(block: &Expr) -> bool {
+    let ExprNode::Lambda { params, rest_param: None, extra_params, block_param: None, body, .. } = &*block.node else { return false };
+    let [param] = params.as_slice() else { return false };
+    if !extra_params.is_empty() { return false; }
+    let statements = match &*body.node { ExprNode::Seq { exprs } => exprs.as_slice(), _ => std::slice::from_ref(body) };
+    !statements.is_empty() && statements.iter().all(|statement| matches!(&*statement.node,
+        ExprNode::Send { recv: Some(recv), method, args, block: Some(block), .. }
+            if (matches!(&*recv.node, ExprNode::SelfRef) || matches!(&*recv.node, ExprNode::Var { name, .. } if name == param))
+            && matches!(method.as_str(), "define_method" | "define_singleton_method")
