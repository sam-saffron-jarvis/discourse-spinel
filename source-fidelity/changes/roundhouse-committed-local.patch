+/// Presence is knowable only in one root-class opening whose load-time
+/// body has no observer/callback/foreign-code edge. Arbitrary stateful module
+/// installation and native method-table presence are NOT inferred here.
+fn root_declaration_availability(
+    app: &App, named: &Named, class: &LibraryClass, macros: &HashSet<Symbol>,
+    call: Span, added: &[MethodDef], sources: &[SourceFile],
+) -> Option<HashMap<Symbol, MethodVisibility>> {
+    if class.parent.is_some() || class.origin.is_some() || !class.includes.is_empty() || class.name.0.as_str().contains("::")
+        || named.library.get(&class.name)?.len() != 1
+        || app.library_classes.iter().any(|class| matches!(class.name.0.as_str(),
+            "Object" | "BasicObject" | "Class" | "Module" | "Kernel" | "Array" | "Hash" | "String" | "Set"))
+        || class.methods.iter().any(|method| method.receiver == MethodReceiver::Class
+            && matches!(method.name.as_str(), "respond_to?" | "respond_to_missing?" | "method_missing"
+                | "singleton_method_added" | "singleton_method_removed" | "singleton_method_undefined"
+                | "method_added" | "inherited" | "const_missing" | "const_added" | "block_given?"))
+        || class.unknown_calls.iter().any(|expr| !matches!(&*expr.node,
+            ExprNode::Send { recv, method, args, block, .. } if macros.contains(method)
+                && block.as_ref().is_none_or(|block| declaration_callback(block) && declaration_callback_syntax(expr, sources))
+                && args.iter().all(|arg| declaration_data_value(arg, true))
+                && recv.as_ref().is_none_or(|recv| matches!(&*recv.node, ExprNode::SelfRef))))
+    { return None; }
+    if class.constants.iter().any(|(_, value)| !declaration_data_value(value, false))
+        || class.class_ivar_initializers.iter().any(|expr| !LibraryClass::is_source_class_initializer(expr)
+            || !matches!(&*expr.node, ExprNode::Assign { value, .. } if declaration_data_value(value, false)))
+    { return None; }
+    let mut available = HashMap::default();
+    for method in class.methods.iter().filter(|method| method.receiver == MethodReceiver::Class
+        && !method.name_span.is_synthetic() && method.name_span.file == call.file && method.name_span.start < call.start)
+        .chain(added.iter().filter(|method| method.receiver == MethodReceiver::Class))
+    {
+        available.insert(method.name.clone(), method.visibility);
+    }
+    Some(available)
+}
