module ActionView
  class SourceAssetResponse
    @app: ^(Hash[String, String]) -> [Integer, Hash[String, String], Array[String]]
    @load_path: SourceAssetLoadPath
    @prefix: String
    @refresh_each_call: bool
    def initialize: (^(Hash[String, String]) -> [Integer, Hash[String, String], Array[String]] app, SourceAssetLoadPath load_path, String prefix, bool sweep_cache, ?String watcher_profile) -> void
    def call: (Hash[String, String] env) -> [Integer, Hash[String, String], Array[String]]
  end
end
