@@ -0,0 +1,203 @@
+//! Executed regression for the narrowly admitted `render_serialized` dispatch.
+//!
+//! The controller/helper/serializer below are a reduced test fixture, not
+//! Discourse runtime or page proof. The helper implementation is a local
+//! contract fixture used only to observe dispatch and response state; the
+//! production gate admits this call shape and does not claim to implement
+//! the framework helper.
+
+#[path = "support/emit_and_run.rs"]
+mod emit_and_run;
+
+fn app() -> emit_and_run::Overlay {
+    emit_and_run::empty_app()
+        .write(
+            "app/controllers/application_controller.rb",
+            r#"class ApplicationController < ActionController::Base
+  attr_accessor :trace
+  attr_reader :helper_calls, :argument_evaluations, :html_effects
+
+  def initialize
+    super
+    @trace = ""
+    @helper_calls = 0
+    @argument_evaluations = 0
+    @html_effects = 0
+  end
+
+  # Test-only stand-in for the framework method: deliberately local to this
+  # fixture, so this test owns the dispatch mechanism without claiming the
+  # real ApplicationController#render_serialized implementation.
+  def render_serialized(rows, serializer)
+    @helper_calls += 1
+    @trace += "helper>"
+    render plain: serializer.new(self).serialize(rows), content_type: "application/json"
+  end
+end
+"#,
+        )
+        .write(
+            "app/models/topic_list_serializer.rb",
+            r#"class TopicListSerializer
+  def serialize(rows)
+    @controller.trace += "serializer>"
+    "serialized:" + rows.join(",")
+  end
+
+  def initialize(controller)
+    @controller = controller
+  end
+end
+"#,
+        )
+        .write(
+            "app/controllers/topics_controller.rb",
+            r#"class TopicsController < ApplicationController
+  def serialized_rows
+    @argument_evaluations += 1
+    @trace += "argument>"
+    ["topic"]
+  end
+
+  def show
+    respond_to do |format|
+      format.html do
+        @html_effects += 1
+        @trace += "html>"
+        head :ok
+      end
+      format.json { render_serialized(serialized_rows, TopicListSerializer) }
+    end
+  end
+end
+"#,
+        )
+}
+
+const ASSERTIONS: &str = r#"
+require_relative "app/controllers/topics_controller"
+require_relative "app/models/topic_list_serializer"
+
+def assert_response(controller, format)
+  if format == :json
+    raise "json response was not rendered: #{controller.body.inspect}" unless controller.body == "serialized:topic"
+    raise "json content type: #{controller.content_type.inspect}" unless controller.content_type == "application/json"
+    raise "json status: #{controller.status.inspect}" unless controller.status == 200
+    raise "json helper count: #{controller.helper_calls}" unless controller.helper_calls == 1
+    raise "json argument evaluated more than once: #{controller.argument_evaluations}" unless controller.argument_evaluations == 1
+    raise "json ran HTML effects: #{controller.html_effects}" unless controller.html_effects == 0
+    raise "json order: #{controller.trace.inspect}" unless controller.trace == "argument>helper>serializer>"
+  else
+    raise "html body: #{controller.body.inspect}" unless controller.body.to_s == ""
+    raise "html status: #{controller.status.inspect}" unless controller.status == 200
+    raise "html content type: #{controller.content_type.inspect}" unless controller.content_type.to_s.start_with?("text/html")
+    raise "html called JSON helper: #{controller.helper_calls}" unless controller.helper_calls == 0
+    raise "html evaluated helper args: #{controller.argument_evaluations}" unless controller.argument_evaluations == 0
+    raise "html side effect count: #{controller.html_effects}" unless controller.html_effects == 1
+    raise "html order: #{controller.trace.inspect}" unless controller.trace == "html>"
+  end
+end
+
+[:json, :html].each do |format|
+  controller = TopicsController.new
+  controller.request_format = format
+  Thread.current[:dispatch_controller] = controller
+  controller.show
+  assert_response(controller, format)
+end
+puts "serialized helper request-format runtime passed"
+"#;
+
+#[test]
+fn serialized_helper_dispatch_executes_on_cruby() {
+    // Use the Spinel target tree for the CRuby oracle so both processes
+    // consume exactly the same lowered controller source.
+    let (emitted, errors) = app().emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{}", errors.join("\n"));
+    let script = format!(
+        "require_relative \"runtime/action_controller/base\"\n$LOADED_FEATURES << File.expand_path(\"runtime/action_controller.rb\", Dir.pwd)\n{ASSERTIONS}"
+    );
+    let output = emit_and_run::ruby()
+        .arg("-e")
+        .arg(script)
+        .current_dir(&emitted)
+        .env("BLOG_DB", ":memory:")
+        .output()
+        .expect("run same Spinel-lowered Ruby under CRuby");
+    assert!(
+        output.status.success(),
+        "same Spinel-lowered Ruby failed under CRuby:\\nstdout={}\\nstderr={}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+#[test]
+#[ignore = "requires the Spinel toolchain"]
+fn serialized_helper_dispatch_executes_on_native_spinel() {
+    app().run_spinel(ASSERTIONS).assert_passes();
+}
+
+#[test]
+fn unsupported_inline_encoder_is_not_admitted_by_the_runtime_fixture() {
+    // Keep this negative control explicit: native-shaped output must not
+    // accidentally route inline JSON through the CRuby-only encoder.
+    let fixture = app().write(
+        "app/controllers/topics_controller.rb",
+        r#"class TopicsController < ApplicationController
+  def inline
+    respond_to do |format|
+      format.html { head :ok }
+      format.json { render json: { ok: true } }
+    end
+  end
+end
+"#,
+    );
+    let (emitted, _app, diagnostics) =
+        fixture.emit_with_app(roundhouse::project::BuildTarget::Spinel);
+    let errors: Vec<_> = diagnostics
+        .iter()
+        .filter(|d| d.severity == roundhouse::diagnostic::Severity::Error)
+        .collect();
+    assert!(
+        errors.is_empty(),
+        "{}",
+        errors
+            .iter()
+            .map(|d| d.message.as_str())
+            .collect::<Vec<_>>()
+            .join("\\n")
+    );
+    let controller = std::fs::read_to_string(emitted.join("app/controllers/topics_controller.rb"))
+        .expect("emitted controller");
+    let action = controller
+        .split("def inline")
+        .nth(1)
+        .expect("inline action");
+    assert!(
+        !action.contains("request_format == :json"),
+        "unsupported encoder branch admitted:\\n{action}"
+    );
+    assert!(
+        !action.contains("JsonRender"),
+        "CRuby-only encoder dependency emitted:\\n{action}"
+    );
+    assert!(
+        !action.contains("json_any"),
+        "broad json_any path was accidentally enabled:\\n{action}"
+    );
+}
+
+#[test]
+fn helper_dispatch_fixture_has_no_cruby_json_render_dependency() {
+    let (emitted, errors) = app().emit(roundhouse::project::BuildTarget::Spinel);
+    assert!(errors.is_empty(), "{}", errors.join("\n"));
+    let controller = std::fs::read_to_string(emitted.join("app/controllers/topics_controller.rb"))
+        .expect("emitted controller");
+    assert!(controller.contains("render_serialized("), "{controller}");
+    assert!(
+        !controller.contains("JsonRender"),
+        "helper path acquired JsonRender dependency:\n{controller}"
+    );
+}
