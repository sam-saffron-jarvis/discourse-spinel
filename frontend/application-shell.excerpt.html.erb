<%# Head bootstrap hooks from the source layout. %>
<%= discourse_csrf_tags %>
<%= module_preloads_for "discourse", nil %>
<%= tag.meta id: 'data-discourse-setup', data: client_side_setup_data %>
<meta name="discourse/config/environment" content="<%=u discourse_config_environment %>" />

<%# Body bootstrap payload and Ember mount point. %>
<discourse-assets>
  <discourse-assets-stylesheets>
    <%= render partial: "common/discourse_stylesheet" %>
